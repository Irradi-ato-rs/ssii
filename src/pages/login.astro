---
// src/pages/login.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');

let translatedError = '';
if (urlError) {
  const boundedError = urlError.slice(0, 64).replace(/[^a-zA-Z0-9_ ]/g, '').toUpperCase();
  
  if (boundedError === 'TENANT_ACCESS_DENIED') {
    translatedError = 'TENANT ACCESS DENIED -- IDENTITY PROVIDER REJECTED FEDERATION.';
  } else if (boundedError) {
    translatedError = `SESSION FAILURE: ${boundedError}`;
  }
}
---

<BaseLayout title="VoidMetric | Authentication Gateway ⟢">
  <main class="w-full max-w-2xl mx-auto px-4 py-16 font-mono text-xs text-slate-300 selection:bg-slate-800">
    
    <header class="mb-12 space-y-2">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        <h1 class="text-xl font-bold tracking-tight text-white">VOIDMETRIC AUTH GATEWAY</h1>
      </div>
      <p class="text-slate-400">Sovereign Systemic Integrity Intelligence</p>
    </header>

    <section class="mb-16 space-y-6 pt-8 border-t border-slate-900">
      {translatedError && (
        <div role="alert" class="p-3 bg-red-900/20 border border-red-900 text-red-400 font-bold rounded break-words uppercase text-[10px]">
          {translatedError}
        </div>
      )}

      <!-- ✅ PURE HTML FORM (No JavaScript) -->
      <form method="POST" action="/api/register" class="space-y-4 w-full">
        <div class="space-y-1.5">
          <label for="email" class="text-[10px] text-slate-500 uppercase font-bold tracking-wider block">
            Corporate Email Address
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="operator@enterprise.com" 
            required 
            autocomplete="email"
            class="w-full bg-[#020203] border border-slate-800 focus:border-blue-500/50 rounded px-3 py-2 text-white outline-none"
          />
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 rounded text-[11px] uppercase transition cursor-pointer">
          [INITIATE HANDSHAKE]
        </button>
      </form>
    </section>

    <Footer />
  </main>
</BaseLayout>   