---
// src/pages/login.astro
import { onBeforePrerenderStart } from 'astro';

// Get query parameters for error handling
const url = new URL(Astro.request.url);
const stat = url.searchParams.get('status');
const err = url.searchParams.get('error');
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>SSII Access Portal / iclassed</title>
		<script src="https://cdn.tailwindcss.com"></script>
	</head>
	<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4">
		<div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl">
			
			<!-- Header -->
			<div class="text-center mb-6">
				<h1 class="text-xl font-black text-blue-500 tracking-wider">SSII ACCESS PORTAL</h1>
				<p class="text-[10px] text-slate-400 uppercase tracking-widest mt-1">Sovereign Systemic Integrity Intelligence</p>
				<p class="text-[9px] text-slate-500 uppercase tracking-widest mt-1">Stateless Identity Gate</p>
			</div>

			<!-- Status Messages -->
			{stat === 'logged_out' && (
				<div class="bg-emerald-950/40 border border-emerald-800 text-emerald-300 p-3 rounded-lg text-xs mb-4 flex items-start gap-2">
					<span>✓</span> Session safely closed. Local cryptographic token cache cleared.
				</div>
			)}
			{err === 'unauthorized' && (
				<div class="bg-rose-950/40 border border-rose-800 text-rose-300 p-3 rounded-lg text-xs mb-4 flex items-start gap-2">
					<span>🛑</span> Domain Not Registered: Your email domain is not in our active registry.
				</div>
			)}
			{err === 'session_expired' && (
				<div class="bg-amber-950/40 border border-amber-800 text-amber-300 p-3 rounded-lg text-xs mb-4 flex items-start gap-2">
					<span>⚠️</span> Session expired. For security, sessions close after 8 hours.
				</div>
			)}
			{err === 'token_validation_failure' && (
				<div class="bg-rose-950/40 border border-rose-800 text-rose-300 p-3 rounded-lg text-xs mb-4 flex items-start gap-2">
					<span>🛑</span> Cryptographic Handshake Failed: Token signature cannot be verified.
				</div>
			)}

			<!-- Login Form -->
			<form action="/api/auth/federate" method="POST" class="space-y-4">
				<div>
					<label class="block text-xs font-bold text-slate-400 uppercase tracking-wide mb-2">
						Corporate Email Address
					</label>
					<input 
						type="email" 
						name="email" 
						required 
						placeholder="name@company.com" 
						class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-sm text-white focus:border-blue-500 outline-none transition" 
					/>
					<p class="text-[10px] text-slate-500 mt-2">
						Supported: Entra ID, Okta. Auto-detects tenant based on domain.
					</p>
				</div>
				
				<button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold p-3 rounded-lg text-sm transition shadow-lg shadow-blue-900/20">
					Sign In via Corporate SSO
				</button>
			</form>

			<div class="mt-6 text-center">
				<p class="text-[10px] text-slate-600">
					Secured by <strong>Sovereign Systemic Integrity Intelligence</strong>.<br/>
					Zero Data Liability Footprint.
				</p>
			</div>
		</div>
	</body>
</html>   
