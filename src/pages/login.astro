---
// src/pages/login.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

// Check for server-side error parameter passed from the redirect flow
const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');

// Map raw technical errors using standard keyboard characters to avoid edge mojibake shifts
let translatedError = '';
if (urlError) {
  if (urlError === 'tenant_access_denied') {
    translatedError = 'TENANT ACCESS DENIED. IDENTITY PROVIDER REJECTED FEDERATION. CONTACT YOUR CORPORATE TECHNOLOGY ADMINISTRATOR TO GET YOUR WORK ACCOUNT ASSIGNED.';
  } else {
    translatedError = `SESSION FAILURE: ${urlError.replace(/[^a-zA-Z0-9_]/g, '').toUpperCase()}`;
  }
}
---


  <main class="w-full max-w-2xl mx-auto px-4 py-16 text-left text-slate-300 font-mono text-xs leading-relaxed selection:bg-slate-800">
    
    <header class="mb-12 space-y-2">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse" aria-hidden="true"></span>
        <h1 class="text-xl font-bold tracking-tight text-white"><a href="https://ssii.fzoirm.com">VOIDMETRIC</a> AUTH GATEWAY</h1>
      </div>
      <p class="text-slate-400">Sovereign Systemic Integrity Intelligence</p>
      <p class="text-slate-500">Zero-Persistence. Edge-Native. Dynamic Tenant Federation.</p>
    </header>

    <!-- Authentication Interface -->
    <section class="mb-16 space-y-6 pt-8 border-t border-slate-900">
      <div class="space-y-1">
        <h2 class="text-slate-500 font-bold uppercase tracking-wider text-[10px]">— ENTERPRISE OPERATOR IDENTIFICATION</h2>
        <p class="text-slate-400">
          Enter your corporate email to initiate the encrypted OIDC handshake. 
          Your domain determines the identity provider (Entra ID / Okta).
        </p>
      </div>

      <!-- Hardened Error Banner Container -->
      <div 
        id="error-banner" 
        role="alert"
        class={`p-3 bg-red-900/20 border border-red-900 text-red-400 text-[10px] uppercase tracking-wider font-bold rounded ${translatedError ? '' : 'hidden'}`}
      >
        {translatedError}
      </div>

      <!-- Login Form -->
      <form id="loginForm" class="space-y-4 max-w-md">
        <div class="space-y-1.5">
          <label for="email" class="text-[10px] text-slate-500 uppercase font-bold tracking-wider block">
            Corporate Email Address
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="operator@enterprise.com" 
            required 
            autocomplete="email"
            class="w-full bg-[#020203] border border-slate-800 focus:border-blue-500/50 rounded px-3 py-2 text-xs text-white placeholder-slate-600 font-mono transition duration-150 outline-none"
          />
        </div>

        <button type="submit" id="submitBtn" class="w-full bg-blue-600 hover:bg-blue-500 disabled:bg-slate-800 disabled:text-slate-500 text-white font-bold py-2.5 rounded text-[11px] uppercase tracking-wider transition duration-150 cursor-pointer disabled:cursor-not-allowed shadow-lg shadow-blue-600/10">
          [INITIATE HANDSHAKE]
        </button>
      </form>

      <div class="text-[10px] text-slate-600 border-t border-slate-900 pt-4 leading-relaxed">
        * VoidMetric uses dynamic zero-persistence routing. Entering your corporate domain triggers an encrypted handshake directly with your pre-provisioned OIDC provider. No credentials are stored on this gateway.
      </div>
    </section>

    <Footer />

  </main>

  <script>
    const form = document.getElementById('loginForm') as HTMLFormElement;
    const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const REQUEST_TIMEOUT_MS = 8000;

    // HARD EXCLUSION: Halt native browser form actions completely
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      e.stopPropagation(); // Block event bubbling into legacy routing listeners
      
      if (errorBanner) errorBanner.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = '[ESTABLISHING SECURE LINK...]';
      }

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);

      try {
        const formData = new FormData(form);
        
        // Explicitly hit the serverless edge worker route relative path natively
        const response = await fetch('/api/register', {
          method: 'POST',
          body: formData,
          signal: controller.signal,
          headers: {
            'Accept': 'application/json'
          }
        });

        clearTimeout(timeoutId);

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error || 'Handshake negotiation rejected by edge');
        }

        const data = await response.json();

        // Validate the return payload target before allowing browser migration
        if (data.redirectUrl && data.redirectUrl.includes('ssii.fzoirm.com')) {
          window.location.replace(data.redirectUrl); // Use replace to drop broken history steps
        } else if (data.redirectUrl) {
          // If the URL is correct but string transformations stacked paths
          window.location.replace(data.redirectUrl);
        } else {
          throw new Error('missing_federation_target_url');
        }

      } catch (err: any) {
        clearTimeout(timeoutId);
        let errorText = 'AUTH FAILURE: HANDSHAKE REJECTED';
        
        if (err.name === 'AbortError') {
          errorText = 'EDGE TIMEOUT: CONNECTION TO SECURE GATEWAY TIMED OUT. RETRY IMPERATIVE.';
        } else if (err.message) {
          const exactMsg = err.message.toUpperCase().replace(/[^a-zA-Z0-9_ ]/g, '');
          errorText = `AUTH FAILURE: ${exactMsg}`;
        }

        if (errorBanner) {
          errorBanner.innerText = errorText;
          errorBanner.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = '[INITIATE HANDSHAKE]';
        }
      }
    });

    // Handle URL Parameter Catch Layer
    const urlParams = new URLSearchParams(window.location.search);
    const errorMsg = urlParams.get('error');
    if (errorMsg && errorBanner) {
      errorBanner.innerText = `SESSION FAILURE: ${errorMsg.replace(/[^a-zA-Z0-9_ ]/g, '').toUpperCase()}`;
      errorBanner.classList.remove('hidden');
    }
  </script>
</BaseLayout>
