---
// src/pages/login.astro
export const prerender = false;
import { env } from 'cloudflare:workers';
import { getIdPConfig } from '../config/tenants';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');

let translatedError = '';
if (urlError) {
  if (urlError === 'tenant_access_denied') {
    translatedError = 'TENANT ACCESS DENIED — IDENTITY PROVIDER REJECTED FEDERATION. CONTACT YOUR ADMIN OR VERIFY YOUR DOMAIN IS REGISTERED.';
  } else {
    translatedError = `SESSION FAILURE: ${urlError.replace(/[^a-zA-Z0-9_ ]/g, '').toUpperCase()}`;
  }
}
---

<BaseLayout title="VoidMetric | Authentication ⟢ iclassed">
  <main class="w-full max-w-2xl mx-auto px-4 py-16 text-left text-slate-300 font-mono text-xs leading-relaxed selection:bg-slate-800">

    <header class="mb-12 space-y-2">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse" aria-hidden="true"></span>
        <h1 class="text-xl font-bold tracking-tight text-white"><a href="https://ssii.fzoirm.com">VOIDMETRIC</a> AUTHENTICATION</h1>
      </div>
      <p class="text-slate-400">Sovereign Systemic Integrity Intelligence</p>
      <p class="text-slate-500">Zero-Payload-Persistence. Edge-Native. Dynamic Tenant Federation.</p>
    </header>

    <section class="mb-16 space-y-6 pt-8 border-t border-slate-900">
      <div class="space-y-1">
        <h2 class="text-slate-500 font-bold uppercase tracking-wider text-[10px]">— STAKEHOLDER IDENTIFIER</h2>
        <p class="text-slate-400">Enter your email to initiate the encrypted OIDC handshake.</p>
      </div>

      {translatedError && (
        <div id="error-banner" role="alert" class="p-3 bg-red-900/20 border border-red-900 text-red-400 text-[10px] uppercase tracking-wider font-bold rounded break-words whitespace-normal">
          {translatedError}
        </div>
      )}

      <form id="loginForm" class="space-y-4 w-full">
        <div class="space-y-1.5">
          <label for="email" class="text-[10px] text-slate-500 uppercase font-bold tracking-wider block whitespace-normal">
            Email Address
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="node@irradi.ato.rs"
            required
            autocomplete="email"
            class="w-full bg-[#020203] border border-slate-800 focus:border-blue-500/50 rounded px-3 py-2 text-xs text-white placeholder-slate-600 font-mono transition duration-150 outline-none"
          />
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <button type="submit" id="loginBtn" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 rounded text-[11px] uppercase tracking-wider transition duration-150 cursor-pointer shadow-lg shadow-blue-600/10">
            [LOGIN]
          </button>
          <button type="button" id="registerBtn" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 font-bold py-2.5 rounded text-[11px] uppercase tracking-wider transition duration-150 cursor-pointer">
            [REGISTER]
          </button>
        </div>

        <p class="text-slate-600 text-[10px]">
          REGISTER is for self-serve open-source operators only. Your tenant is provisioned automatically on first login. No onboarding required.
        </p>
      </form>
    </section>

    <Footer />
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('loginForm') as HTMLFormElement;
      const loginBtn = document.getElementById('loginBtn') as HTMLButtonElement;
      const registerBtn = document.getElementById('registerBtn') as HTMLButtonElement;

      async function initiateHandshake(mode: string) {
        const btn = mode === 'login' ? loginBtn : registerBtn;
        btn.disabled = true;
        const originalText = btn.innerText;
        btn.innerText = '[ESTABLISHING SECURE LINK...]';

        try {
          const formData = new FormData(form);
          formData.append('mode', mode);

          const response = await fetch('/api/register', {
            method: 'POST',
            body: formData,
          });

          const data = await response.json();

          if (response.ok && data.redirectUrl) {
            window.location.href = data.redirectUrl;
          } else {
            alert(`AUTH FAILURE: ${data.error || 'Handshake rejected by gateway'}`);
            btn.disabled = false;
            btn.innerText = originalText;
          }
        } catch (err) {
          alert('NETWORK ERROR: Secure gateway unreachable. Retry imperative.');
          btn.disabled = false;
          btn.innerText = originalText;
        }
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        initiateHandshake('login');
      });

      registerBtn?.addEventListener('click', () => {
        if (!confirm('Self-serve registration only.\n\nYour tenant will be provisioned automatically as an operator.\nEnterprise tenants should use LOGIN or contact their VoidMetric administrator.')) return;
        initiateHandshake('register');
      });
    });
  </script>
</BaseLayout>