---
// src/pages/login.astro
export const prerender = false;

import Footer from '../components/Footer.astro';

const url = new URL(Astro.request.url);
const stat = url.searchParams.get('status');
const err = url.searchParams.get('error');
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>VoidMetric Access</title>
		<script src="https://cdn.tailwindcss.com"></script>
	</head>
	<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 font-mono">
		<div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl space-y-6">
			
			<!-- Header -->
			<div class="text-left border-b border-slate-800 pb-4">
				<h1 class="text-xl font-black text-white tracking-wider">VOIDMETRIC ACCESS</h1>
				<p class="text-[10px] text-slate-400 uppercase tracking-widest mt-1">Stateless Integrity Intelligence</p>
				<p class="text-[9px] text-slate-500 uppercase tracking-widest mt-0.5">Zero-Persistence Security</p>
			</div>

			<!-- Status Messages -->
			{stat === 'logged_out' && (
				<div class="bg-emerald-950/40 border border-emerald-800 text-emerald-300 p-3 rounded-lg text-xs flex items-start gap-2">
					<span>✓</span> Session safely closed. No data persisted.
				</div>
			)}
			{err === 'unauthorized' && (
				<div class="bg-rose-950/40 border border-rose-800 text-rose-300 p-3 rounded-lg text-xs flex items-start gap-2">
					<span>🛑</span> Access Denied: Your organization's domain name is not registered.
				</div>
			)}
			{err === 'session_expired' && (
				<div class="bg-amber-950/40 border border-amber-800 text-amber-300 p-3 rounded-lg text-xs flex items-start gap-2">
					<span>⚠️</span> Session expired. Please sign in again.
				</div>
			)}
			{err === 'token_validation_failure' && (
				<div class="bg-rose-950/40 border border-rose-800 text-rose-300 p-3 rounded-lg text-xs flex items-start gap-2">
					<span>🛑</span> Authentication Failed: Invalid identity token.
				</div>
			)}

			<!-- Login Form -->
			<form action="/api/register" method="POST" class="space-y-4">
				<div class="space-y-2">
					<label class="block text-xs font-bold text-slate-400 uppercase tracking-wide">
						Corporate Email Address
					</label>
					<input 
						type="email" 
						name="email" 
						required 
						placeholder="name@company.com" 
						class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-sm text-white focus:border-blue-500 outline-none transition" 
					/>
					<p class="text-[10px] text-slate-500">
						Authorized corporate domain names only.
					</p>
				</div>
				
				<button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold p-3 rounded-lg text-xs uppercase tracking-wider transition shadow-lg shadow-blue-900/20 cursor-pointer">
					Sign In via SSO
				</button>
			</form>

			<!-- Registration / Contact Block -->
			<div class="text-left border-t border-slate-800 pt-4 space-y-1">
				<a href="" class="inline-block text-xs font-bold text-blue-400 underline underline-offset-4 hover:text-blue-300 transition">
					Contact Us to Onboard →
				</a>
				<p class="text-[10px] text-slate-500">
					Provisioning required for new tenants, kindly communicate it.
				</p>
			</div>

			<!-- Standard Shared Footer -->
			<Footer />

		</div>
	</body>
</html>
