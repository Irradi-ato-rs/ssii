---
// src/pages/login.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

// 1. Catch the error passed back from Microsoft on the server side
const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');

let translatedError = '';
if (urlError) {
  if (urlError === 'tenant_access_denied') {
    translatedError = 'TENANT ACCESS DENIED — IDENTITY PROVIDER REJECTED FEDERATION. CONTACT YOUR CORPORATE IT ADMINISTRATOR TO ASSIGN YOUR WORK ACCOUNT.';
  } else {
    translatedError = `SESSION FAILURE: ${urlError.replace(/_/g, ' ').toUpperCase()}`;
  }
}
---


  <main class="w-full max-w-2xl mx-auto px-4 py-16 text-left text-slate-300 font-mono text-xs leading-relaxed selection:bg-slate-800">
    
    <header class="mb-12 space-y-2">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        <h1 class="text-xl font-bold tracking-tight text-white"><a href="https://ssii.fzoirm.com">VOIDMETRIC</a> AUTH GATEWAY</h1>
      </div>
      <p class="text-slate-400">Sovereign Systemic Integrity Intelligence</p>
      <p class="text-slate-500">Zero-Persistence. Edge-Native. Dynamic Tenant Federation.</p>
    </header>

    <!-- Authentication Interface -->
    <section class="mb-16 space-y-6 pt-8 border-t border-slate-900">
      <div class="space-y-1">
        <h2 class="text-slate-500 font-bold uppercase tracking-wider text-[10px]">— ENTERPRISE OPERATOR IDENTIFICATION</h2>
        <p class="text-slate-400">
          Enter your corporate email to initiate the encrypted OIDC handshake. 
          Your domain determines the identity provider (Entra ID / Okta et al).
        </p>
      </div>

      <!-- 2. Display the error here dynamically if it exists, otherwise keep it hidden -->
      <div 
        id="error-banner" 
        class={`p-3 bg-red-900/20 border border-red-900 text-red-400 text-[10px] uppercase tracking-wider font-bold rounded ${translatedError ? '' : 'hidden'}`}
      >
        {translatedError}
      </div>

      <!-- Login Form -->
      <form id="loginForm" class="space-y-4 max-w-md">
        <div class="space-y-1.5">
          <label for="email" class="text-[10px] text-slate-500 uppercase font-bold tracking-wider block">
            Corporate Email Address
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="www@irradi.ato.rs" 
            required 
            class="w-full bg-[#020203] border border-slate-800 focus:border-blue-500/50 rounded px-3 py-2 text-xs text-white placeholder-slate-600 font-mono transition duration-150 outline-none"
          />
        </div>

        <button type="submit" id="submitBtn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 rounded text-[11px] uppercase tracking-wider transition duration-150 cursor-pointer shadow-lg shadow-blue-600/10">
          [INITIATE HANDSHAKE]
        </button>
      </form>

      <div class="text-[10px] text-slate-600 border-t border-slate-900 pt-4 leading-relaxed">
        * VoidMetric uses dynamic zero-persistence routing. Entering your corporate domain triggers an encrypted handshake directly with your pre-provisioned OIDC provider. No credentials are stored on this gateway.
      </div>
    </section>

    <Footer />

  </main>

  <script>
    // 3. Keep your existing client-side script running exactly as it was
    const form = document.getElementById('loginForm') as HTMLFormElement;
    const errorBanner = document.getElementById('error-banner');
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      errorBanner?.classList.add('hidden');
      if(submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = '[ESTABLISHING SECURE LINK...]';
      }

      const formData = new FormData(form);

      try {
        const response = await fetch('/api/register', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok && data.redirectUrl) {
          window.location.href = data.redirectUrl;
        } else {
          throw new Error(data.error || 'Handshake failed');
        }
      } catch (err: any) {
        if(errorBanner) {
          errorBanner.innerText = `AUTH FAILURE: ${err.message.toUpperCase()}`;
          errorBanner.classList.remove('hidden');
        }
        if(submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = '[INITIATE HANDSHAKE]';
        }
      }
    });

    const urlParams = new URLSearchParams(window.location.search);
    const errorMsg = urlParams.get('error');
    if (errorMsg && errorBanner) {
      if (errorMsg === 'tenant_access_denied') {
        errorBanner.innerText = 'TENANT ACCESS DENIED — IDENTITY PROVIDER REJECTED FEDERATION. CONTACT YOUR CORPORATE IT ADMINISTRATOR TO ASSIGN YOUR WORK ACCOUNT.';
      } else {
        errorBanner.innerText = `SESSION FAILURE: ${errorMsg.replace(/_/g, ' ').toUpperCase()}`;
      }
      errorBanner.classList.remove('hidden');
    }
  </script>
</BaseLayout>
