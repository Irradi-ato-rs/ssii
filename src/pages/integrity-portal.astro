---
// src/pages/integrity-portal.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?error=access_denied');
---

<BaseLayout title="VoidMetric | Integrity Portal">
  <main class="w-full max-w-2xl mx-auto px-4 py-16 text-left text-slate-300 font-mono text-xs leading-relaxed">
    
    <header class="mb-12 space-y-2">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <h1 class="text-xl font-bold tracking-tight text-white">INTEGRITY PORTAL</h1>
      </div>
      <p class="text-slate-400">Operator: <span class="text-white">{user.email}</span></p>
      <p class="text-slate-500">Role: <span class="text-blue-400 uppercase">{user.role}</span> | Tenant: {user.tenant}</p>
    </header>

    <!-- Admin Only Section -->
    {user.role === 'admin' && (
      <section class="mb-8 p-4 border border-blue-900/50 bg-blue-900/10 rounded">
        <h2 class="text-blue-400 font-bold uppercase tracking-wider text-[10px] mb-2">— ADMIN CONTROLS</h2>
        <p class="text-slate-400">Tenant provisioning and global override parameters accessible.</p>
        <button class="mt-2 text-[10px] bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-500">[MANAGE TENANTS]</button>
      </section>
    )}

    <!-- Standard Metrics (Visible to all roles) -->
    <section class="p-4 border border-slate-800 bg-slate-900/30 rounded">
      <h2 class="text-slate-500 font-bold uppercase tracking-wider text-[10px] mb-4">— SYSTEM STATUS</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <div class="text-slate-500 text-[10px]">METRIC A (COMPLIANCE)</div>
          <div class="text-2xl text-white font-bold">98.4%</div>
        </div>
        <div>
          <div class="text-slate-500 text-[10px]">METRIC B (INTEGRITY)</div>
          <div class="text-2xl text-emerald-400 font-bold">100%</div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>   