// src/pages/integrity-portal.astro
---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

// 1. ERROR INTERCEPTION
const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');
if (urlError) {
  return Astro.redirect(`/login?error=${urlError}`);
}

// 2. HARD SECURITY ISOLATION
if (!Astro.locals.user) {
  return Astro.redirect('/login?error=unauthenticated_session_gateway');
}
const user = Astro.locals.user;
const isFirstVisit = !Astro.cookies.has('ssii_onboard_complete');

// 3. ANTI-CACHING HEADERS
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');
---
<BaseLayout title="VoidMetric Controller">
  <meta 
    http-equiv="Content-Security-Policy" 
    content="default-src 'self'; script-src 'self' 'unsafe-inline' https://tailwindcss.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';"
    slot="head"
  />

  <main class="w-full max-w-5xl mx-auto px-4 py-8 text-left text-slate-300 font-mono text-xs leading-relaxed selection:bg-slate-800 selection:text-white space-y-6">
    
    <!-- Top Operational Status Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center p-6 bg-slate-900/40 border border-slate-900 rounded-xl gap-4">
      <div>
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <h1 class="text-lg font-black tracking-wider text-white">VOIDMETRIC // SSII</h1>
        </div>
        <p class="text-slate-500 text-[10px] uppercase tracking-widest mt-1">Sovereign Systemic Integrity Intelligence Engine</p>
      </div>
      <div class="text-left md:text-right text-xs space-y-0.5">
        <p class="text-slate-400">OPERATOR: <span class="font-bold text-white">{user.email}</span></p>
        <p class="text-slate-500 uppercase">ACCESS_SCOPE: <span class="text-blue-400 font-bold">{user.role}</span></p>
        <form method="POST" action="/api/auth/signout" class="mt-2 inline-block">
          <button type="submit" class="text-rose-400/80 hover:text-rose-400 underline underline-offset-4 font-bold transition cursor-pointer bg-transparent border-none p-0">
            /terminate-session
          </button>
        </form>
      </div>
    </div>

    <!-- Onboarding Modal -->
    {isFirstVisit && (
      <div id="onboarding-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md px-4">
        <div class="bg-[#09090b] border border-blue-500/20 p-8 rounded-xl max-w-md w-full shadow-2xl space-y-6">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-white uppercase tracking-wider">// INITIALIZING NODE ENTRY</h2>
            <p class="text-slate-500 text-[11px]">Systemic Integrity matrix calibration will execute inside volatile memory maps.</p>
          </div>
          <div class="space-y-3 text-[11px] border-y border-slate-900 py-4">
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-5 h-5 rounded bg-emerald-950 text-emerald-400 font-bold">✓</span>
              <span class="text-slate-400">Federated Identity Claims Confirmed via SSO</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-5 h-5 rounded bg-blue-950 text-blue-400 font-bold">2</span>
              <span class="text-slate-400">Establishes Homomorphic Noise Blinding Vectors</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-5 h-5 rounded bg-slate-900 text-slate-500 font-bold">3</span>
              <span class="text-slate-400">Isolates Structural Compliance Gaps</span>
            </div>
          </div>
          <button id="startTourBtn" type="button" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded text-xs transition duration-200 cursor-pointer shadow-lg shadow-blue-600/10">
            [EXECUTE_SYSTEM_CALIBRATION_TOUR]
          </button>
        </div>
      </div>
    )}

    <!-- Primary Telemetry Panel -->
    <div class="bg-[#07070a] border border-slate-900 rounded-xl p-6 space-y-6 shadow-xl">
      <div class="space-y-1.5">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider">🧪 Live Stream Computation Matrix Terminal</h2>
        <p class="text-slate-500 text-[11px] leading-relaxed">
          Real-time matrix decomposition of structural integrity vectors. Data sourced from edge parsing workers.
        </p>
      </div>
      
      <div class="flex flex-wrap gap-3">
        <button id="testMath" type="button" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 px-5 rounded text-xs transition duration-150 tracking-wide shadow-md shadow-blue-600/10 cursor-pointer">
          [RUN_BLIND_TELEMETRY_CALCULATION]
        </button>
        <button id="injectZeroBtn" type="button" class="bg-slate-900 border border-rose-900/60 hover:bg-rose-950/30 text-rose-400 font-bold py-2.5 px-5 rounded text-xs transition duration-150 tracking-wide cursor-pointer">
          [INJECT_STRUCTURAL_ZERO_VECTOR]
        </button>
      </div>

      <!-- Dynamic Feedback Indicators -->
      <div id="results" class="hidden space-y-6 pt-4 border-t border-slate-900">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
          <div class="bg-[#020203] p-4 rounded border border-slate-900 space-y-1">
            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Metric A // Compliance Posture Sum</p>
            <p id="resA" class="text-xl font-bold text-slate-100">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900 space-y-1">
            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Metric B // Real Operational Integrity</p>
            <p id="resB" class="text-xl font-bold transition-colors duration-200">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900 space-y-1">
            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Operational Security Status</p>
            <p id="resStatus" class="text-[11px] font-bold uppercase tracking-wider transition-colors duration-200">-</p>
          </div>
        </div>
        
        <!-- Threat Warnings -->
        <div id="theaterAlarm" class="hidden p-4 bg-rose-950/20 border border-rose-900/50 rounded text-rose-400 text-[11px] space-y-1">
          <p class="font-bold">// CRITICAL INTEGRITY DELTA DETECTED</p>
          <p class="text-rose-500/90">Formal checkmarks remain high, but live integrity index indicates acute single-point failure exposure.</p>
        </div>
        
        { (user.role === 'engineer' || user.role === 'admin') && (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <!-- Spectral Analysis -->
            <div class="bg-[#020203] p-4 rounded border border-slate-900 space-y-2">
              <p class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Spectral Topology Analytics (Engineer View)</p>
              <div class="text-[11px] space-y-1 text-slate-400">
                <div>Chaos Index Penalty : <span id="specChaos" class="text-white font-bold">-</span></div>
                <div>Max Eigenvalue Peak : <span id="specEigen" class="text-white">-</span></div>
                <div>Exploit Alignment   : <span id="specResonance" class="font-bold">-</span></div>
              </div>
            </div>

            <!-- Raw Stream Log -->
            <div class="bg-[#020203] p-4 rounded border border-slate-900 space-y-2">
              <p class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Blinded Homomorphic Stream Map</p>
              <div id="rawStreamLog" class="text-[9px] text-slate-600 break-all max-h-[70px] overflow-y-auto leading-normal">
                Initializing buffer array...
              </div>
            </div>
          </div>
        )}
      </div>
    </div>

    <Footer />
  </main>

  <script>
    // Onboarding Modal
    const startTourBtn = document.getElementById('startTourBtn');
    const onboardingModal = document.getElementById('onboarding-modal');
    startTourBtn?.addEventListener('click', () => {
      document.cookie = "ssii_onboard_complete=true; path=/; max-age=31536000; SameSite=Lax";
      onboardingModal?.classList.add('hidden');
    });

    // Real API Call to /api/compute
    const testMathBtn = document.getElementById('testMath');
    const injectZeroBtn = document.getElementById('injectZeroBtn');
    const resultsSection = document.getElementById('results');

    async function triggerCalculation(forceExploit = false) {
      if (!resultsSection) return;
      resultsSection.classList.remove('hidden');

      try {
        // Generate test payload (32-element padded stream)
        const testStream = Array.from({ length: 32 }, (_, i) => ({
          maskedValue: forceExploit && i === 0 ? 0.01 : 0.5 + Math.random() * 0.5,
          evaluationWeight: [0.4, 0.3, 0.3][i % 3],
          capabilityPriority: [0.50, 0.30, 0.15, 0.05][Math.floor(i / 8)],
          lastTelemetryHeartbeat: Math.floor(Date.now() / 1000)
        }));

        const threatIntel = forceExploit ? [0.9, 0.8, 0.7] : [0.1, 0.1, 0.1];

        const response = await fetch('/api/compute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            paddedStream: testStream,
            threatIntelVector: threatIntel
          })
        });

        if (!response.ok) throw new Error('Compute engine failed');
        const data = await response.json();

        // Update UI with real data
        document.getElementById('resA').innerText = `${(data.metric_a_compliance * 100).toFixed(1)}%`;
        
        const resB = document.getElementById('resB');
        resB.innerText = `${(data.metric_b_integrity * 100).toFixed(1)}%`;
        resB.className = data.status === 'CRITICAL_RISK_SWITCH_TRIGGERED' 
          ? 'text-xl font-bold text-red-500' 
          : 'text-xl font-bold text-emerald-400';

        const resStatus = document.getElementById('resStatus');
        resStatus.innerText = data.status.replace(/_/g, ' ');
        resStatus.className = data.status === 'CRITICAL_RISK_SWITCH_TRIGGERED'
          ? 'text-[11px] font-bold uppercase tracking-wider text-red-500 bg-red-950/30 px-2 py-0.5 rounded border border-red-900/50'
          : 'text-[11px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/30 px-2 py-0.5 rounded border border-emerald-900/50';

        // Theater Gap Alarm
        const theaterAlarm = document.getElementById('theaterAlarm');
        if (data.theater_gap_delta > 0.3) {
          theaterAlarm.classList.remove('hidden');
        } else {
          theaterAlarm.classList.add('hidden');
        }

        // Engineer/Admin Spectral View
        if (data.spectral_analysis) {
          document.getElementById('specChaos').innerText = data.spectral_analysis.chaos_index_penalty.toFixed(5);
          document.getElementById('specEigen').innerText = data.spectral_analysis.principal_eigenvalue.toFixed(5);
          const specResonance = document.getElementById('specResonance');
          specResonance.innerText = data.spectral_analysis.resonance_exploit_chain_detected ? 'VECTOR LINK DETECTED' : 'NONE';
          specResonance.className = data.spectral_analysis.resonance_exploit_chain_detected ? 'text-red-400 font-bold' : 'text-slate-400';
        }

        // Raw Stream Log (show first 10 validations)
        const rawStreamLog = document.getElementById('rawStreamLog');
        if (data.row_validations) {
          rawStreamLog.innerText = `[${data.row_validations.slice(0, 10).join(', ')}...]`;
        }

      } catch (error) {
        console.error('Computation failed:', error);
        document.getElementById('resStatus').innerText = 'COMPUTATION_ERROR';
      }
    }

    testMathBtn?.addEventListener('click', () => triggerCalculation(false));
    injectZeroBtn?.addEventListener('click', () => triggerCalculation(true));
    
    // Back-button cache invalidation
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) window.location.reload();
    });
  </script>
</BaseLayout>   