---
// src/pages/integrity-portal.astro
export const prerender = false;
import { env } from 'cloudflare:workers';
import { runScoringEngine } from '../lib/scoring-engine';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

// 1. ERROR INTERCEPTION
const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');
if (urlError) {
  return Astro.redirect(`/login?error=${urlError}`);
}

// 2. HARD SECURITY ISOLATION BOUNDARY
if (!Astro.locals.user) {
  return Astro.redirect('/login?error=unauthenticated_session_gateway');
}

const user = Astro.locals.user;
const tenantId = user.tenant;

// 3. API KEY MANAGEMENT
let apiKey = "pending-generation";
let apiKeyError = false;
let errorMessage = "";

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    if (form.get('action') !== 'regenerate_key') {
      return Astro.redirect('/integrity-portal');
    }
    const randomBytes = new Uint8Array(32);
    crypto.getRandomValues(randomBytes);
    const newKey = Array.from(randomBytes).map(b => b.toString(16).padStart(2, '0')).join('');
    if (env.VM_TENANT_DIRECTORY) {
      await env.VM_TENANT_DIRECTORY.put(`apikey:${tenantId}`, newKey);
      apiKey = newKey;
    } else {
      apiKeyError = true;
      errorMessage = "KV Binding Missing";
    }
  } catch (err) {
    apiKeyError = true;
    errorMessage = (err as Error).message;
  }
} else {
  try {
    if (env.VM_TENANT_DIRECTORY) {
      const storedKey = await env.VM_TENANT_DIRECTORY.get(`apikey:${tenantId}`);
      if (storedKey) {
        apiKey = storedKey;
      } else {
        const randomBytes = new Uint8Array(32);
        crypto.getRandomValues(randomBytes);
        const newKey = Array.from(randomBytes).map(b => b.toString(16).padStart(2, '0')).join('');
        await env.VM_TENANT_DIRECTORY.put(`apikey:${tenantId}`, newKey);
        apiKey = newKey;
      }
    } else {
      apiKeyError = true;
      errorMessage = "KV Binding Missing";
    }
  } catch (err) {
    apiKeyError = true;
    errorMessage = (err as Error).message;
  }
}

const webhookUrl = `https://void.fzoirm.com/ingest/${tenantId}`;

// 4. LIVE POSTURE (sync compute — zero-persistence)
let livePosture: any = null;
try {
  if (env.VM_TENANT_DIRECTORY) {
    const stored = await env.VM_TENANT_DIRECTORY.get(`telemetry:${tenantId}`);
    if (stored) {
      const parsed = JSON.parse(stored);
      const current = parsed.current || parsed;
      const previous = parsed.previous || null;

      let tenantHyperparams = null;
      try {
        const hpRaw = await env.VM_TENANT_DIRECTORY.get(`hyperparams:${tenantId}`);
        if (hpRaw) tenantHyperparams = JSON.parse(hpRaw);
      } catch (_) {}

      const result = runScoringEngine(
        current.paddedStream,
        current.threatIntelVector || [0, 0, 0],
        previous ? previous.paddedStream : undefined,
        previous ? previous.threatIntelVector : undefined,
        tenantHyperparams || undefined
      );
      livePosture = { ...result, computedAt: new Date().toISOString() };
    }
  }
} catch (err) {
  console.error('[VoidMetric Portal] Compute failed:', err);
}
---

<BaseLayout title="VoidMetric Controller // Sovereign Systemic Integrity Intelligence">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';" slot="head" />

  <main class="w-full max-w-7xl mx-auto px-6 py-10 text-left text-slate-300 font-mono text-xs leading-relaxed">

    <!-- Header -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 pb-6 border-b border-slate-800">
      <div>
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <h1 class="text-xl font-black tracking-wider text-white"><a href="https://ssii.fzoirm.com">VOIDMETRIC</a> // Center of Excellence / dashboard</h1>
        </div>
        <p class="text-slate-500 text-[10px] uppercase tracking-widest mt-1">Security Intelligence and Risk Mitigation Engine</p>
      </div>
      <div class="text-left md:text-right text-xs space-y-1 mt-4 md:mt-0">
        <p class="text-slate-400">OPERATOR: <span class="font-bold text-white">{user.email}</span></p>
        <p class="text-slate-500 uppercase">ACCESS_SCOPE: <span class="text-blue-400 font-bold">{user.role}</span></p>
        <form method="POST" action="/api/auth/signout" class="inline-block">
          <button type="submit" class="text-rose-400/80 hover:text-rose-400 underline cursor-pointer bg-transparent border-none p-0">/terminate-session</button>
        </form>
      </div>
    </header>

    <!-- BENTO GRID LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 auto-rows-min">

      <!-- 1. LIVE TENANT POSTURE -->
      <div class="lg:col-span-8 bg-[#07070a] border border-slate-800 rounded-xl p-6 shadow-lg flex flex-col justify-between">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-sm font-bold text-white uppercase tracking-wider">📡 Live Tenant Posture</h2>
          {livePosture && <span class="text-[9px] text-slate-500">Synced {livePosture.computedAt}</span>}
        </div>

        {livePosture ? (
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric A // Compliance</p>
              <p class="text-2xl font-bold text-slate-100">{(livePosture.metric_a_compliance * 100).toFixed(1)}%</p>
              {livePosture.metric_a_velocity !== null && livePosture.metric_a_velocity !== undefined && (
                <p class={`text-[10px] mt-1 font-bold ${livePosture.metric_a_velocity > 0 ? 'text-emerald-400' : livePosture.metric_a_velocity < 0 ? 'text-red-400' : 'text-slate-500'}`}>
                  Δ {(livePosture.metric_a_velocity > 0 ? '+' : '') + (livePosture.metric_a_velocity * 100).toFixed(2)}
                </p>
              )}
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric B // Integrity</p>
              <p class={`text-2xl font-bold ${livePosture.metric_b_integrity < 0.2 ? 'text-red-500' : 'text-emerald-400'}`}>
                {(livePosture.metric_b_integrity * 100).toFixed(1)}%
              </p>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50 flex flex-col justify-center">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Status</p>
              <p class={`text-[11px] font-bold uppercase px-2 py-1 rounded border inline-block w-fit ${livePosture.status === 'CRITICAL_RISK_SWITCH_TRIGGERED' ? 'text-red-500 bg-red-950/30 border-red-900/50' : 'text-emerald-400 bg-emerald-950/30 border-emerald-900/50'}`}>
                {livePosture.status.replace(/_/g, ' ')}
              </p>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Watermelon Index</p>
              <p class={`text-2xl font-bold ${livePosture.watermelon_index > 0.5 ? 'text-rose-400' : 'text-slate-100'}`}>
                {(livePosture.watermelon_index * 100).toFixed(1)}%
              </p>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Honest Failure Index</p>
              <p class="text-2xl font-bold text-slate-100">{(livePosture.honest_failure_index * 100).toFixed(1)}%</p>
            </div>
          </div>
        ) : (
          <div class="flex items-center justify-center h-32 text-slate-500 text-[11px]">
            No telemetry available.
          </div>
        )}
      </div>

      <!-- 2. INGESTION CONFIG -->
      <div class="lg:col-span-4 bg-[#07070a] border border-blue-900/30 rounded-xl p-6 shadow-lg flex flex-col">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider mb-4">🔗 Configuration Setting</h2>
        <p class="text-slate-500 text-[10px] mb-4 leading-relaxed">
          1. Set the URL 👇 in Okta, Tenable, Sentinel or another supported platform to link it as the ingestion target.<br/>
          2. Set the API Key 👇 along in your platform's <code>Authorization</code> header writing in the text field both <code>Bearer</code> and the API key with a space.
        </p>

        <div class="mb-4">
          <label class="text-[9px] text-slate-500 uppercase font-bold block mb-1">Webhook URL</label>
          <code id="webhookCode" class="block w-full bg-[#020203] border border-slate-800 rounded p-2 text-[9px] text-emerald-400 break-all font-mono select-all">{webhookUrl}</code>
          <button type="button" data-copy={webhookUrl} class="copy-btn mt-1 text-[9px] text-blue-400 hover:text-blue-300 underline cursor-pointer">Copy URL</button>
        </div>

        <div class="mb-4 flex-grow">
          <label class="text-[9px] text-slate-500 uppercase font-bold block mb-1">API Key (Bearer)</label>
          {apiKeyError ? (
            <div class="w-full bg-red-950/20 border border-red-900/50 rounded p-2 text-[9px] text-red-400 font-mono">
              {errorMessage}
            </div>
          ) : (
            <code id="apiKeyCode" class="block w-full bg-[#020203] border border-slate-800 rounded p-2 text-[9px] text-emerald-400 break-all font-mono select-all">{apiKey}</code>
          )}
          <button type="button" data-copy={apiKey} class="copy-btn mt-1 text-[9px] text-blue-400 hover:text-blue-300 underline cursor-pointer">Copy Key</button>
        </div>

        <form method="POST" class="w-full">
          <input type="hidden" name="action" value="regenerate_key" />
          <button type="submit" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 py-2 rounded text-[10px] uppercase font-bold transition">
            🔄 Regenerate Key
          </button>
        </form>
      </div>

      <!-- 3. SANDBOX TERMINAL -->
      <div class="lg:col-span-12 bg-[#07070a] border border-slate-800 rounded-xl p-6 shadow-lg">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-sm font-bold text-white uppercase tracking-wider">🧪 Computation Matrix</h2>
            <p class="text-slate-500 text-[10px]">Synthetic 12-element stream test bench</p>
          </div>
          <div class="flex gap-3">
            <button id="testMathBtn" type="button" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 px-4 rounded text-[10px] uppercase tracking-wide cursor-pointer transition">
              [Run Blind Telemetry]
            </button>
            <button id="injectZeroBtn" type="button" class="bg-slate-900 border border-rose-900/60 hover:bg-rose-950/30 text-rose-400 font-bold py-2 px-4 rounded text-[10px] uppercase tracking-wide cursor-pointer transition">
              [Inject Zero Vector]
            </button>
          </div>
        </div>

        <div id="results" class="hidden grid grid-cols-2 md:grid-cols-5 gap-4 pt-6 border-t border-slate-900">
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric A</p>
            <p id="resA" class="text-xl font-bold text-slate-100">-</p>
            <p id="resAVel" class="text-[10px] font-bold mt-1">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric B</p>
            <p id="resB" class="text-xl font-bold">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Status</p>
            <p id="resStatus" class="text-[11px] font-bold uppercase">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Watermelon Index</p>
            <p id="resWI" class="text-xl font-bold">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Honest Failure</p>
            <p id="resHF" class="text-xl font-bold">-</p>
          </div>
        </div>

        <div id="theaterAlarm" class="hidden mt-4 p-4 bg-rose-950/20 border border-rose-900/50 rounded text-rose-400 text-[11px]">
          <p class="font-bold">// CRITICAL WATERMELON INDEX — COMPLIANCE DECEPTION DETECTED</p>
        </div>

        { (user.role === 'engineer' || user.role === 'admin' || user.role === 'governance' || user.role === 'executive') && (
          <div id="engineerPanel" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4 pt-6 border-t border-slate-900">
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-3">Spectral Analytics</p>
              <div class="space-y-2 text-[11px] text-slate-400">
                <div class="flex justify-between"><span>Chaos Index:</span> <span id="specChaos" class="text-white font-bold">-</span></div>
                <div class="flex justify-between"><span>Eigenvalue:</span> <span id="specEigen" class="text-white">-</span></div>
                <div class="flex justify-between"><span>Resonance:</span> <span id="specResonance" class="font-bold">-</span></div>
              </div>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-3">Raw Stream Map</p>
              <div id="rawStreamLog" class="text-[9px] text-slate-600 break-all max-h-[80px] overflow-y-auto font-mono leading-tight">
                Initializing buffer...
              </div>
            </div>
          </div>
        )}
      </div>

    </div>

    <Footer />
  </main>

  <script>
    window.addEventListener('pageshow', (event) => { if (event.persisted) window.location.reload(); });

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Copy Button Logic
      const copyButtons = document.querySelectorAll('.copy-btn');
      copyButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const textToCopy = (e.target as HTMLElement).getAttribute('data-copy');
          if (textToCopy) {
            navigator.clipboard.writeText(textToCopy).then(() => {
              const originalText = (e.target as HTMLElement).innerText;
              (e.target as HTMLElement).innerText = "Copied!";
              setTimeout(() => { (e.target as HTMLElement).innerText = originalText; }, 2000);
            }).catch(() => alert('Failed to copy to clipboard'));
          }
        });
      });

      // 2. Sandbox Logic
      const testMathBtn = document.getElementById('testMathBtn');
      const injectZeroBtn = document.getElementById('injectZeroBtn');
      const resultsSection = document.getElementById('results');
      const engineerPanel = document.getElementById('engineerPanel');

      let lastStream: any[] = [];
      let lastThreatVector: number[] = [0, 0, 0];

      function buildSyntheticStream(forceExploit: boolean) {
        const now = Math.floor(Date.now() / 1000);
        const nodes = [];
        for (let i = 0; i < 4; i++) {
          for (let j = 0; j < 3; j++) {
            const isZeroTarget = forceExploit && i === 2 && j === 2;
            nodes.push({
              maskedValue: isZeroTarget ? 0.02 : 0.85 + Math.random() * 0.15,
              row: i,
              col: j,
              lastTelemetryHeartbeat: now,
            });
          }
        }
        return nodes;
      }

      async function triggerCalculation(forceExploit: boolean) {
        if (!resultsSection) return;
        resultsSection.classList.remove('hidden');
        resultsSection.classList.add('grid');
        if (engineerPanel) {
          engineerPanel.classList.remove('hidden');
          engineerPanel.classList.add('grid');
        }

        const resA = document.getElementById('resA');
        const resAVel = document.getElementById('resAVel');
        const resB = document.getElementById('resB');
        const resStatus = document.getElementById('resStatus');
        const resWI = document.getElementById('resWI');
        const resHF = document.getElementById('resHF');
        const theaterAlarm = document.getElementById('theaterAlarm');
        const rawStreamLog = document.getElementById('rawStreamLog');
        const specChaos = document.getElementById('specChaos');
        const specEigen = document.getElementById('specEigen');
        const specResonance = document.getElementById('specResonance');

        try {
          const currentStream = buildSyntheticStream(forceExploit);

          const response = await fetch('/api/sandbox', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              paddedStream: currentStream,
              threatIntelVector: lastThreatVector,
              previousStream: lastStream.length === 12 ? lastStream : undefined,
              previousThreatIntelVector: lastStream.length === 12 ? lastThreatVector : undefined,
            }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error);

          lastStream = currentStream;
          lastThreatVector = [0, 0, 0];

          if (resA) resA.innerText = `${(data.metric_a_compliance * 100).toFixed(1)}%`;
          if (resAVel) {
            if (data.metric_a_velocity !== null && data.metric_a_velocity !== undefined) {
              const v = data.metric_a_velocity;
              resAVel.innerText = `Δ ${v > 0 ? '+' : ''}${(v * 100).toFixed(2)}`;
              resAVel.className = `text-[10px] font-bold mt-1 ${v > 0 ? 'text-emerald-400' : v < 0 ? 'text-red-400' : 'text-slate-500'}`;
            } else {
              resAVel.innerText = 'Δ first cycle';
              resAVel.className = 'text-[10px] font-bold mt-1 text-slate-600';
            }
          }
          if (resB) {
            resB.innerText = `${(data.metric_b_integrity * 100).toFixed(1)}%`;
            resB.className = data.metric_b_integrity < 0.2 ? 'text-xl font-bold text-red-500' : 'text-xl font-bold text-emerald-400';
          }
          if (resStatus) {
            const critical = data.status === 'CRITICAL_RISK_SWITCH_TRIGGERED';
            resStatus.innerText = data.status.replace(/_/g, ' ');
            resStatus.className = critical ? 'text-[11px] font-bold uppercase text-red-500' : 'text-[11px] font-bold uppercase text-emerald-400';
          }
          if (resWI) {
            resWI.innerText = `${(data.watermelon_index * 100).toFixed(1)}%`;
            resWI.className = data.watermelon_index > 0.5 ? 'text-xl font-bold text-rose-400' : 'text-xl font-bold text-slate-100';
          }
          if (resHF) resHF.innerText = `${(data.honest_failure_index * 100).toFixed(1)}%`;

          if (theaterAlarm) {
            const deceptive = (data.watermelon_index ?? 0) > 0.5;
            deceptive ? theaterAlarm.classList.remove('hidden') : theaterAlarm.classList.add('hidden');
          }

          if (data.spectral_analysis) {
            if (specChaos) specChaos.innerText = data.spectral_analysis.chaos_index_penalty.toFixed(4);
            if (specEigen) specEigen.innerText = data.spectral_analysis.principal_eigenvalue.toFixed(4);
            if (specResonance) {
              specResonance.innerText = data.spectral_analysis.resonance_exploit_chain_detected ? 'VECTOR LINK DETECTED' : 'NONE';
              specResonance.className = data.spectral_analysis.resonance_exploit_chain_detected ? 'text-red-400 font-bold' : 'text-slate-400';
            }
            if (rawStreamLog) rawStreamLog.innerText = `[SANDBOX RUN — provenance: ${data.provenance || 'local'}]`;
          }
        } catch (err) {
          if (rawStreamLog) rawStreamLog.innerText = `Error: ${(err as Error).message}`;
        }
      }

      testMathBtn?.addEventListener('click', () => triggerCalculation(false));
      injectZeroBtn?.addEventListener('click', () => triggerCalculation(true));
    });
  </script>
</BaseLayout>   