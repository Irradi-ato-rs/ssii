---
// src/pages/integrity-portal.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { env } from 'cloudflare:workers';

// 1. ERROR INTERCEPTION
const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');
if (urlError) {
  return Astro.redirect(`/login?error=${urlError}`);
}

// 2. HARD SECURITY ISOLATION BOUNDARY
if (!Astro.locals.user) {
  return Astro.redirect('/login?error=unauthenticated_session_gateway');
}

const user = Astro.locals.user;
const isFirstVisit = !Astro.cookies.has('ssii_onboard_complete');

// 3. REQUEST SIGNED URL FROM PRIVATE CORE (Via Service Binding)
// CRITICAL FIX: Use a valid absolute URL (http://void.internal) for the Request constructor.
// Service Bindings ignore the hostname but require valid URL syntax.
let webhookUrl = "pending-configuration";
let urlErrorOccurred = false;
let errorMessage = "";

try {
  if (env.PRIVATE_GATEWAY) {
    const bindingRequest = new Request("http://void.internal/api/generate-url", {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${env.PRIVATE_INTERNAL_SYSTEM_TOKEN}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ tenantId: user.tenant })
    });

    const response = await env.PRIVATE_GATEWAY.fetch(bindingRequest);

    if (response.ok) {
      const data = await response.json();
      webhookUrl = data.url;
    } else {
      const errText = await response.text();
      console.error(`[VoidMetric] Core returned ${response.status}: ${errText}`);
      urlErrorOccurred = true;
      errorMessage = `Core Error ${response.status}`;
    }
  } else {
    console.error("[VoidMetric] PRIVATE_GATEWAY binding not found. Check wrangler.jsonc");
    urlErrorOccurred = true;
    errorMessage = "Missing Service Binding";
  }
} catch (err) {
  console.error("[VoidMetric] Failed to contact void core:", err);
  urlErrorOccurred = true;
  errorMessage = (err as Error).message;
}

// 4. LIVE POSTURE (Read-Only)
let livePosture: any = null;
try {
  if (env.VM_LIVE_POSTURE_CACHE) {
    const raw = await env.VM_LIVE_POSTURE_CACHE.get(user.tenant);
    if (raw) livePosture = JSON.parse(raw);
  }
} catch (err) {
  console.error('[VoidMetric Portal] Cache read failed:', err);
}
---

<BaseLayout title="VoidMetric Controller // Sovereign Systemic Integrity Intelligence">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://tailwindcss.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';" slot="head" />
  
  <main class="w-full max-w-5xl mx-auto px-4 py-8 text-left text-slate-300 font-mono text-xs leading-relaxed space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center p-6 bg-slate-900/40 border border-slate-900 rounded-xl gap-4">
      <div>
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <h1 class="text-lg font-black tracking-wider text-white"><a href="https://ssii.fzoirm.com">VOIDMETRIC</a> // Security Intelligence Posture</h1>
        </div>
        <p class="text-slate-500 text-[10px] uppercase tracking-widest mt-1">Sovereign Systemic Integrity Intelligence Engine</p>
      </div>
      <div class="text-left md:text-right text-xs space-y-0.5">
        <p class="text-slate-400">OPERATOR: <span class="font-bold text-white">{user.email}</span></p>
        <p class="text-slate-500 uppercase">ACCESS_SCOPE: <span class="text-blue-400 font-bold">{user.role}</span></p>
        <form method="POST" action="/api/auth/signout" class="mt-2 inline-block">
          <button type="submit" class="text-rose-400/80 hover:text-rose-400 underline cursor-pointer bg-transparent border-none p-0">/terminate-session</button>
        </form>
      </div>
    </div>

    <!-- LIVE POSTURE PANEL -->
    <div class="bg-[#07070a] border border-slate-900 rounded-xl p-6 space-y-4 shadow-xl">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-white uppercase">📡 Live Tenant Posture</h2>
        {livePosture && <span class="text-[9px] text-slate-500">Synced {livePosture.computedAt}</span>}
      </div>
      {livePosture ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-[#020203] p-4 rounded border border-slate-900">
            <p class="text-[10px] text-slate-500 uppercase font-bold">Metric A // Compliance</p>
            <p class="text-xl font-bold text-slate-100">{(livePosture.metric_a_compliance * 100).toFixed(1)}%</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900">
            <p class="text-[10px] text-slate-500 uppercase font-bold">Metric B // Integrity</p>
            <p class={`text-xl font-bold ${livePosture.metric_b_integrity < 0.2 ? 'text-red-500' : 'text-emerald-400'}`}>
              {(livePosture.metric_b_integrity * 100).toFixed(1)}%
            </p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900">
            <p class="text-[10px] text-slate-500 uppercase font-bold">Status</p>
            <p class={`text-[11px] font-bold uppercase px-2 py-0.5 rounded border inline-block ${livePosture.status === 'CRITICAL_RISK_SWITCH_TRIGGERED' ? 'text-red-500 bg-red-950/30 border-red-900/50' : 'text-emerald-400 bg-emerald-950/30 border-emerald-900/50'}`}>
              {livePosture.status.replace(/_/g, ' ')}
            </p>
          </div>
        </div>
      ) : (
        <div class="p-4 bg-slate-900/30 border border-slate-800 rounded text-slate-500">
          No telemetry synced yet. Configure your log target below.
        </div>
      )}
    </div>

    <!-- DETERMINISTIC INGESTION ENDPOINT -->
    <div class="bg-[#07070a] border border-blue-900/30 rounded-xl p-6 space-y-4 shadow-xl">
      <h2 class="text-sm font-bold text-white uppercase">🔗 Deterministic Ingestion Endpoint</h2>
      <p class="text-slate-500 text-[11px]">
        Configure your log targets (Okta, Tenable, Sentinel) to POST to this URL. 
        Authentication is embedded in the path via cryptographic signature generated by the private core.
      </p>
      
      <div class="relative group">
        {urlErrorOccurred ? (
          <div class="w-full bg-red-950/20 border border-red-900/50 rounded p-3 text-[10px] text-red-400 font-mono">
            Error: {errorMessage}. Check Worker logs and Service Binding.
          </div>
        ) : (
          <code class="block w-full bg-[#020203] border border-slate-800 rounded p-3 text-[10px] text-emerald-400 break-all font-mono select-all">
            {webhookUrl}
          </code>
        )}
        
        {!urlErrorOccurred && (
          <button 
            type="button"
            onclick="navigator.clipboard.writeText('{webhookUrl}'); alert('URL copied to clipboard');"
            class="absolute top-2 right-2 text-[10px] bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded transition opacity-0 group-hover:opacity-100"
          >
            COPY URL
          </button>
        )}
      </div>
      <p class="text-[10px] text-slate-600">
        ⚠️ This URL is unique to your tenant. If compromised, clear your session to generate a new timestamped signature.
      </p>
    </div>

    <!-- SANDBOX TERMINAL -->
    <div class="bg-[#07070a] border border-slate-900 rounded-xl p-6 space-y-6 shadow-xl">
      <div class="space-y-1.5">
        <h2 class="text-sm font-bold text-white uppercase">🧪 Live Stream Computation Matrix</h2>
        <p class="text-slate-500 text-[11px]">Submits a synthetic 32-element stream through the scoring engine.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <button id="testMathBtn" type="button" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 px-5 rounded text-xs cursor-pointer">[RUN_BLIND_TELEMETRY]</button>
        <button id="injectZeroBtn" type="button" class="bg-slate-900 border border-rose-900/60 hover:bg-rose-950/30 text-rose-400 font-bold py-2.5 px-5 rounded text-xs cursor-pointer">[INJECT_ZERO_VECTOR]</button>
      </div>
      
      <div id="results" class="hidden space-y-6 pt-4 border-t border-slate-900">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-[#020203] p-4 rounded border border-slate-900">
            <p class="text-[10px] text-slate-500 uppercase font-bold">Metric A</p>
            <p id="resA" class="text-xl font-bold text-slate-100">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900">
            <p class="text-[10px] text-slate-500 uppercase font-bold">Metric B</p>
            <p id="resB" class="text-xl font-bold">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900">
            <p class="text-[10px] text-slate-500 uppercase font-bold">Status</p>
            <p id="resStatus" class="text-[11px] font-bold uppercase">-</p>
          </div>
        </div>
        <div id="theaterAlarm" class="hidden p-4 bg-rose-950/20 border border-rose-900/50 rounded text-rose-400 text-[11px]">
          <p class="font-bold">// CRITICAL COMPLIANCE THEATER DELTA DETECTED</p>
        </div>
        { (user.role === 'engineer' || user.role === 'admin') && (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="bg-[#020203] p-4 rounded border border-slate-900">
              <p class="text-[10px] text-slate-500 uppercase font-bold">Spectral Analytics</p>
              <div class="text-[11px] space-y-1 text-slate-400">
                <div>Chaos Index: <span id="specChaos" class="text-white font-bold">-</span></div>
                <div>Eigenvalue: <span id="specEigen" class="text-white">-</span></div>
              </div>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900">
              <p class="text-[10px] text-slate-500 uppercase font-bold">Raw Stream Map</p>
              <div id="rawStreamLog" class="text-[9px] text-slate-600 break-all max-h-[70px] overflow-y-auto">Initializing...</div>
            </div>
          </div>
        )}
      </div>
    </div>

    <Footer />
  </main>

  <script>
    window.addEventListener('pageshow', (event) => { if (event.persisted) window.location.reload(); });

    document.addEventListener('DOMContentLoaded', () => {
      const testMathBtn = document.getElementById('testMathBtn');
      const injectZeroBtn = document.getElementById('injectZeroBtn');
      const resultsSection = document.getElementById('results');
      
      function buildSyntheticStream(forceExploit: boolean) {
        const now = Math.floor(Date.now() / 1000);
        const nodes = [];
        for (let i = 0; i < 32; i++) {
          const isZeroTarget = forceExploit && i === 8;
          nodes.push({
            maskedValue: isZeroTarget ? 0.02 : 0.85 + Math.random() * 0.15,
            evaluationWeight: 0.3,
            capabilityPriority: 0.05,
            lastTelemetryHeartbeat: now
          });
        }
        return nodes;
      }

      async function triggerCalculation(forceExploit: boolean) {
        if (!resultsSection) return;
        resultsSection.classList.remove('hidden');
        const resA = document.getElementById('resA');
        const resB = document.getElementById('resB');
        const resStatus = document.getElementById('resStatus');
        const theaterAlarm = document.getElementById('theaterAlarm');
        const rawStreamLog = document.getElementById('rawStreamLog');
        const specChaos = document.getElementById('specChaos');
        const specEigen = document.getElementById('specEigen');

        try {
          const response = await fetch('/api/compute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              paddedStream: buildSyntheticStream(forceExploit),
              threatIntelVector: [0.0, 0.0, 0.0],
            }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error);

          if (resA) resA.innerText = `${(data.metric_a_compliance * 100).toFixed(1)}%`;
          if (resB) {
            resB.innerText = `${(data.metric_b_integrity * 100).toFixed(1)}%`;
            resB.className = data.metric_b_integrity < 0.2 ? 'text-xl font-bold text-red-500' : 'text-xl font-bold text-emerald-400';
          }
          if (resStatus) {
            const critical = data.status === 'CRITICAL_RISK_SWITCH_TRIGGERED';
            resStatus.innerText = data.status.replace(/_/g, ' ');
            resStatus.className = critical ? 'text-[11px] font-bold uppercase text-red-500' : 'text-[11px] font-bold uppercase text-emerald-400';
            if (theaterAlarm) critical ? theaterAlarm.classList.remove('hidden') : theaterAlarm.classList.add('hidden');
          }
          if (data.spectral_analysis) {
            if (specChaos) specChaos.innerText = data.spectral_analysis.chaos_index_penalty.toFixed(4);
            if (specEigen) specEigen.innerText = data.spectral_analysis.principal_eigenvalue.toFixed(4);
          }
        } catch (err) {
          if (rawStreamLog) rawStreamLog.innerText = `Error: ${(err as Error).message}`;
        }
      }

      testMathBtn?.addEventListener('click', () => triggerCalculation(false));
      injectZeroBtn?.addEventListener('click', () => triggerCalculation(true));
    });
  </script>
</BaseLayout>   