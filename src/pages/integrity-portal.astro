---
// src/pages/integrity-portal.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { env } from 'cloudflare:workers';

// 1. ERROR INTERCEPTION
const url = new URL(Astro.request.url);
const urlError = url.searchParams.get('error');
if (urlError) {
  return Astro.redirect(`/login?error=${urlError}`);
}

// 2. HARD SECURITY ISOLATION BOUNDARY
if (!Astro.locals.user) {
  return Astro.redirect('/login?error=unauthenticated_session_gateway');
}

const user = Astro.locals.user;
const isFirstVisit = !Astro.cookies.has('ssii_onboard_complete');

// 3. REQUEST SIGNED URL FROM PRIVATE CORE (Via Service Binding)
let webhookUrl = "pending-configuration";
let urlErrorOccurred = false;
let errorMessage = "";

try {
  if (env.PRIVATE_GATEWAY) {
    const bindingRequest = new Request("http://void.internal/api/generate-url", {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${env.PRIVATE_INTERNAL_SYSTEM_TOKEN}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ tenantId: user.tenant })
    });

    const response = await env.PRIVATE_GATEWAY.fetch(bindingRequest);

    if (response.ok) {
      const data = await response.json();
      webhookUrl = data.url;
    } else {
      const errText = await response.text();
      console.error(`[VoidMetric] Core returned ${response.status}: ${errText}`);
      urlErrorOccurred = true;
      errorMessage = `Core Error ${response.status}`;
    }
  } else {
    console.error("[VoidMetric] PRIVATE_GATEWAY binding not found.");
    urlErrorOccurred = true;
    errorMessage = "Missing Service Binding";
  }
} catch (err) {
  console.error("[VoidMetric] Failed to contact void core:", err);
  urlErrorOccurred = true;
  errorMessage = (err as Error).message;
}

// 4. LIVE POSTURE (Read-Only)
let livePosture: any = null;
try {
  if (env.VM_LIVE_POSTURE_CACHE) {
    const raw = await env.VM_LIVE_POSTURE_CACHE.get(user.tenant);
    if (raw) livePosture = JSON.parse(raw);
  }
} catch (err) {
  console.error('[VoidMetric Portal] Cache read failed:', err);
}
---

<BaseLayout title="VoidMetric Controller // Sovereign Systemic Integrity Intelligence">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://tailwindcss.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';" slot="head" />
  
  <main class="w-full max-w-7xl mx-auto px-6 py-10 text-left text-slate-300 font-mono text-xs leading-relaxed">
    
    <!-- Header -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 pb-6 border-b border-slate-800">
      <div>
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <h1 class="text-xl font-black tracking-wider text-white"><a href="https://ssii.fzoirm.com">VOIDMETRIC</a> // dashboard / webhook</h1>
        </div>
        <p class="text-slate-500 text-[10px] uppercase tracking-widest mt-1">Sovereign Systemic Integrity Intelligence Engine</p>
      </div>
      <div class="text-left md:text-right text-xs space-y-1 mt-4 md:mt-0">
        <p class="text-slate-400">OPERATOR: <span class="font-bold text-white">{user.email}</span></p>
        <p class="text-slate-500 uppercase">ACCESS_SCOPE: <span class="text-blue-400 font-bold">{user.role}</span></p>
        <form method="POST" action="/api/auth/signout" class="inline-block">
          <button type="submit" class="text-rose-400/80 hover:text-rose-400 underline cursor-pointer bg-transparent border-none p-0">/terminate-session</button>
        </form>
      </div>
    </header>

    <!-- BENTO GRID LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 auto-rows-min">

      <!-- 1. LIVE TENANT POSTURE (Hero Tile: Spans 8 cols) -->
      <div class="lg:col-span-8 bg-[#07070a] border border-slate-800 rounded-xl p-6 shadow-lg flex flex-col justify-between">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-sm font-bold text-white uppercase tracking-wider">📡 Live Tenant Posture</h2>
          {livePosture && <span class="text-[9px] text-slate-500">Synced {livePosture.computedAt}</span>}
        </div>
        
        {livePosture ? (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric A // Compliance</p>
              <p class="text-2xl font-bold text-slate-100">{(livePosture.metric_a_compliance * 100).toFixed(1)}%</p>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric B // Integrity</p>
              <p class={`text-2xl font-bold ${livePosture.metric_b_integrity < 0.2 ? 'text-red-500' : 'text-emerald-400'}`}>
                {(livePosture.metric_b_integrity * 100).toFixed(1)}%
              </p>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50 flex flex-col justify-center">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Status</p>
              <p class={`text-[11px] font-bold uppercase px-2 py-1 rounded border inline-block w-fit ${livePosture.status === 'CRITICAL_RISK_SWITCH_TRIGGERED' ? 'text-red-500 bg-red-950/30 border-red-900/50' : 'text-emerald-400 bg-emerald-950/30 border-emerald-900/50'}`}>
                {livePosture.status.replace(/_/g, ' ')}
              </p>
            </div>
          </div>
        ) : (
          <div class="flex items-center justify-center h-32 text-slate-500 text-[11px]">
            No telemetry synced yet.
          </div>
        )}
      </div>

      <!-- 2. INGESTION ENDPOINT (Side Tile: Spans 4 cols) -->
      <div class="lg:col-span-4 bg-[#07070a] border border-blue-900/30 rounded-xl p-6 shadow-lg flex flex-col">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider mb-4">🔗 Ingestion Endpoint</h2>
        <p class="text-slate-500 text-[10px] mb-4 leading-relaxed">
          Configure Okta/Sentinel to POST to this URL. Auth embedded in path.
        </p>
        
        <div class="flex-grow flex items-center">
          {urlErrorOccurred ? (
            <div class="w-full bg-red-950/20 border border-red-900/50 rounded p-3 text-[10px] text-red-400 font-mono">
              {errorMessage}
            </div>
          ) : (
            <code class="block w-full bg-[#020203] border border-slate-800 rounded p-2 text-[9px] text-emerald-400 break-all font-mono select-all">
              {webhookUrl}
            </code>
          )}
        </div>
        
        {!urlErrorOccurred && (
          <button 
            type="button"
            onclick="navigator.clipboard.writeText('{webhookUrl}'); alert('URL copied');"
            class="mt-4 w-full bg-blue-600/10 hover:bg-blue-600/20 text-blue-400 border border-blue-600/30 py-2 rounded text-[10px] uppercase font-bold transition"
          >
            Copy URL
          </button>
        )}
      </div>

      <!-- 3. SANDBOX TERMINAL (Full Width: Spans 12 cols) -->
      <div class="lg:col-span-12 bg-[#07070a] border border-slate-800 rounded-xl p-6 shadow-lg">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-sm font-bold text-white uppercase tracking-wider">🧪 Computation Matrix</h2>
            <p class="text-slate-500 text-[10px]">Synthetic 32-element stream test bench</p>
          </div>
          <div class="flex gap-3">
            <button id="testMathBtn" type="button" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 px-4 rounded text-[10px] uppercase tracking-wide cursor-pointer transition">
              [Run Blind Telemetry]
            </button>
            <button id="injectZeroBtn" type="button" class="bg-slate-900 border border-rose-900/60 hover:bg-rose-950/30 text-rose-400 font-bold py-2 px-4 rounded text-[10px] uppercase tracking-wide cursor-pointer transition">
              [Inject Zero Vector]
            </button>
          </div>
        </div>
        
        <div id="results" class="hidden grid grid-cols-1 md:grid-cols-3 gap-4 pt-6 border-t border-slate-900">
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric A</p>
            <p id="resA" class="text-xl font-bold text-slate-100">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Metric B</p>
            <p id="resB" class="text-xl font-bold">-</p>
          </div>
          <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Status</p>
            <p id="resStatus" class="text-[11px] font-bold uppercase">-</p>
          </div>
        </div>
        
        <!-- Theater Alarm -->
        <div id="theaterAlarm" class="hidden mt-4 p-4 bg-rose-950/20 border border-rose-900/50 rounded text-rose-400 text-[11px]">
          <p class="font-bold">// CRITICAL COMPLIANCE THEATER DELTA DETECTED</p>
        </div>

        <!-- Engineer Only: Spectral & Raw Stream (Spans 6+6) -->
        { (user.role === 'engineer' || user.role === 'admin') && (
          <div id="engineerPanel" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-4 mt-4 pt-6 border-t border-slate-900">
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-3">Spectral Analytics</p>
              <div class="space-y-2 text-[11px] text-slate-400">
                <div class="flex justify-between"><span>Chaos Index:</span> <span id="specChaos" class="text-white font-bold">-</span></div>
                <div class="flex justify-between"><span>Eigenvalue:</span> <span id="specEigen" class="text-white">-</span></div>
                <div class="flex justify-between"><span>Resonance:</span> <span id="specResonance" class="font-bold">-</span></div>
              </div>
            </div>
            <div class="bg-[#020203] p-4 rounded border border-slate-900/50">
              <p class="text-[10px] text-slate-500 uppercase font-bold mb-3">Raw Stream Map</p>
              <div id="rawStreamLog" class="text-[9px] text-slate-600 break-all max-h-[80px] overflow-y-auto font-mono leading-tight">
                Initializing buffer...
              </div>
            </div>
          </div>
        )}
      </div>

    </div>

    <Footer />
  </main>

  <script>
    window.addEventListener('pageshow', (event) => { if (event.persisted) window.location.reload(); });

    document.addEventListener('DOMContentLoaded', () => {
      const testMathBtn = document.getElementById('testMathBtn');
      const injectZeroBtn = document.getElementById('injectZeroBtn');
      const resultsSection = document.getElementById('results');
      const engineerPanel = document.getElementById('engineerPanel');
      
      function buildSyntheticStream(forceExploit: boolean) {
        const now = Math.floor(Date.now() / 1000);
        const nodes = [];
        for (let i = 0; i < 32; i++) {
          const isZeroTarget = forceExploit && i === 8;
          nodes.push({
            maskedValue: isZeroTarget ? 0.02 : 0.85 + Math.random() * 0.15,
            evaluationWeight: 0.3,
            capabilityPriority: 0.05,
            lastTelemetryHeartbeat: now
          });
        }
        return nodes;
      }

      async function triggerCalculation(forceExploit: boolean) {
        if (!resultsSection) return;
        resultsSection.classList.remove('hidden');
        resultsSection.classList.add('grid'); // Restore grid display
        if(engineerPanel) {
            engineerPanel.classList.remove('hidden');
            engineerPanel.classList.add('grid');
        }

        const resA = document.getElementById('resA');
        const resB = document.getElementById('resB');
        const resStatus = document.getElementById('resStatus');
        const theaterAlarm = document.getElementById('theaterAlarm');
        const rawStreamLog = document.getElementById('rawStreamLog');
        const specChaos = document.getElementById('specChaos');
        const specEigen = document.getElementById('specEigen');
        const specResonance = document.getElementById('specResonance');

        try {
          const response = await fetch('/api/compute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              paddedStream: buildSyntheticStream(forceExploit),
              threatIntelVector: [0.0, 0.0, 0.0],
            }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error);

          if (resA) resA.innerText = `${(data.metric_a_compliance * 100).toFixed(1)}%`;
          if (resB) {
            resB.innerText = `${(data.metric_b_integrity * 100).toFixed(1)}%`;
            resB.className = data.metric_b_integrity < 0.2 ? 'text-xl font-bold text-red-500' : 'text-xl font-bold text-emerald-400';
          }
          if (resStatus) {
            const critical = data.status === 'CRITICAL_RISK_SWITCH_TRIGGERED';
            resStatus.innerText = data.status.replace(/_/g, ' ');
            resStatus.className = critical ? 'text-[11px] font-bold uppercase text-red-500' : 'text-[11px] font-bold uppercase text-emerald-400';
            if (theaterAlarm) critical ? theaterAlarm.classList.remove('hidden') : theaterAlarm.classList.add('hidden');
          }
          if (data.spectral_analysis) {
            if (specChaos) specChaos.innerText = data.spectral_analysis.chaos_index_penalty.toFixed(4);
            if (specEigen) specEigen.innerText = data.spectral_analysis.principal_eigenvalue.toFixed(4);
            if (specResonance) {
                specResonance.innerText = data.spectral_analysis.resonance_exploit_chain_detected ? 'VECTOR LINK DETECTED' : 'NONE';
                specResonance.className = data.spectral_analysis.resonance_exploit_chain_detected ? 'text-red-400 font-bold' : 'text-slate-400';
            }
            if(rawStreamLog) rawStreamLog.innerText = `[SANDBOX RUN — provenance: ${data.provenance || 'local'}]`;
          }
        } catch (err) {
          if (rawStreamLog) rawStreamLog.innerText = `Error: ${(err as Error).message}`;
        }
      }

      testMathBtn?.addEventListener('click', () => triggerCalculation(false));
      injectZeroBtn?.addEventListener('click', () => triggerCalculation(true));
    });
  </script>
</BaseLayout>   