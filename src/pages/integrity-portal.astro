---
// src/pages/integrity-portal.astro
export const prerender = false;

// 1. SECURITY: Redirect if not logged in
if (!Astro.locals.user) {
  return Astro.redirect('/');
}

const user = Astro.locals.user;
// Check for 'firstVisit' cookie
const isFirstVisit = Astro.cookies.get('ssii_onboard_complete') === undefined;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VoidMetric | Integrity Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen p-8">
    <div class="max-w-5xl mx-auto">
      
      <!-- Header -->
      <div class="flex justify-between items-center mb-8 border-b border-slate-800 pb-4">
        <div>
          <h1 class="text-3xl font-black text-blue-500">VOIDMETRIC</h1>
          <p class="text-slate-400 text-sm">Sovereign Systemic Integrity Intelligence</p>
        </div>
        <div class="text-right">
          <p class="text-sm text-slate-300">Welcome, <span class="font-bold text-white">{user.email}</span></p>
          <p class="text-xs text-slate-500 uppercase tracking-wider">Role: {user.role}</p>
          <a href="/api/auth/logout" class="text-xs text-red-400 hover:text-red-300 mt-1 inline-block">Sign Out</a>
        </div>
      </div>

      <!-- ✅ ONBOARDING MODAL (Only shows on first visit) -->
      {isFirstVisit && (
        <div id="onboarding-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm">
          <div class="bg-slate-900 border border-blue-500/30 p-8 rounded-2xl max-w-lg w-full shadow-2xl">
            <h2 class="text-xl font-black text-white mb-4">👋 Welcome to VoidMetric</h2>
            <p class="text-slate-400 text-sm mb-6">Let's calculate your Systemic Integrity in under 2 minutes.</p>
            
            <ul class="space-y-3 text-sm text-slate-300">
              <li class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-900 text-emerald-400 font-bold text-xs">✓</span>
                <span>Authenticated via Corporate SSO</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-900 text-blue-400 font-bold text-xs">2</span>
                <span>Run Demo Calculation (Pre-filled)</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-slate-800 text-slate-500 font-bold text-xs">3</span>
                <span>View Integrity Score</span>
              </li>
            </ul>

            <button onclick="startDemoOnboarding()" class="w-full mt-6 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl transition">
              Start Interactive Tour
            </button>
          </div>
        </div>
      )}

      <!-- Demo Section -->
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-8 shadow-lg">
        <h2 class="text-xl font-bold text-white mb-4">🧪 Live Math Verification</h2>
        <p class="text-slate-400 text-sm mb-6">
          Click below to submit a test matrix with a <strong>critical failure</strong> (Score 0.0).
          Observe how <strong>Metric A</strong> remains high while <strong>Metric B</strong> collapses.
        </p>
        
        <button id="testMath" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-6 rounded-lg transition shadow-lg shadow-blue-900/20">
          Run Demo Calculation
        </button>

        <div id="results" class="mt-6 hidden">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-slate-950 p-4 rounded border border-slate-800">
              <p class="text-xs text-slate-500 uppercase">Metric A (Compliance)</p>
              <p id="resA" class="text-2xl font-mono text-emerald-400">-</p>
            </div>
            <div class="bg-slate-950 p-4 rounded border border-slate-800">
              <p class="text-xs text-slate-500 uppercase">Metric B (Integrity)</p>
              <p id="resB" class="text-2xl font-mono text-red-400">-</p>
            </div>
            <div class="bg-slate-950 p-4 rounded border border-slate-800">
              <p class="text-xs text-slate-500 uppercase">Status</p>
              <p id="resStatus" class="text-sm font-bold text-white uppercase">-</p>
            </div>
          </div>
          {user.role === 'engineer' || user.role === 'admin' ? (
            <div class="mt-4 bg-slate-950 p-4 rounded border border-slate-800">
              <p class="text-xs text-slate-500 uppercase mb-2">Row Validations (Engineer View)</p>
              <pre id="resRows" class="text-xs font-mono text-slate-300 overflow-x-auto">-</pre>
            </div>
          ) : ''}
        </div>
      </div>

    </div>

    <script>
      // Onboarding Logic
      function startDemoOnboarding() {
        // Trigger the compute button automatically
        document.getElementById('testMath').click();
        
        // Set cookie to hide modal next time
        document.cookie = "ssii_onboard_complete=true; path=/; max-age=31536000";
        
        // Close modal
        document.getElementById('onboarding-modal').classList.add('hidden');
      }

      // Demo Calculation Logic
      document.getElementById('testMath').addEventListener('click', async () => {
        const btn = document.getElementById('testMath');
        const results = document.getElementById('results');
        
        btn.disabled = true;
        btn.innerText = "Computing...";
        results.classList.add('hidden');

        try {
          const response = await fetch('/api/v1/compute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              matrix: [
                [0.95, 0.90, 0.95],
                [0.90, 0.95, 0.90],
                [0.95, 0.90, 0.00], // Critical Failure
                [0.90, 0.90, 0.95]
              ]
            })
          });

          const data = await response.json();

          document.getElementById('resA').innerText = data.metric_a_compliance;
          document.getElementById('resB').innerText = data.metric_b_integrity;
          document.getElementById('resStatus').innerText = data.status;
          
          if (data.row_validations) {
            document.getElementById('resRows').innerText = JSON.stringify(data.row_validations, null, 2);
          }

          results.classList.remove('hidden');
        } catch (err) {
          alert('Error running calculation: ' + err);
        } finally {
          btn.disabled = false;
          btn.innerText = "Run Demo Calculation";
        }
      });
    </script>
  </body>
</html>   