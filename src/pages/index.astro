---
// src/pages/index.astro
/* ⟢✨ Stateless Ephemeral Risk Pipelines */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sovereign Systemic Integrity Intelligence">
  <main class="w-full max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">
      Sovereign Systemic Integrity Intelligence
    </h1>
    
    <p class="text-sm md:text-base text-slate-400 max-w-xl mx-auto mt-4">
      Real-time cybersecurity structural robustness and continuous maturity tracking built on a 
      <strong class="text-slate-200">zero-data liability footprint</strong>.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center pt-8">
      <a href="/login" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-8 py-3 rounded-xl text-sm transition shadow-lg shadow-blue-900/20">
        Authenticate Domain Portal
      </a>
    </div>

    <!-- Live Simulator Placeholder -->
    <div class="mt-12 w-full bg-slate-900 border border-slate-800 p-6 rounded-2xl text-left relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-blue-500 to-indigo-500 opacity-40"></div>
      <div class="text-center py-8 text-slate-500 text-xs">
        🕹️ Live Simulator Sandbox <br/>
        <span class="opacity-70">Interactive math engine loading in next step...</span>
      </div>
    </div>
  </main>

  <footer class="mt-12 text-[10px] text-slate-600">
    ©2026 Systemic Integrity Sovereign Intelligence⟢. All rights reserved.
  </footer>
</BaseLayout>   
