---
// src/pages/index.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="VoidMetric | Sovereign Systemic Integrity Intelligence">
  <main class="w-full max-w-2xl mx-auto px-4 py-16 text-left text-slate-300 font-mono text-xs leading-relaxed selection:bg-slate-800">

    <header class="mb-12 space-y-2">
      <h1 class="text-xl font-bold tracking-tight text-white">VOIDMETRIC</h1>
      <p class="text-slate-400">Sovereign Systemic Integrity Intelligence</p>
      <p class="text-slate-500">Zero-Persistence. Edge-Native. Non-Linear Operational Validation Engine.</p>
    </header>

    <!-- Navigation Directory -->
    <section class="mb-12 space-y-4">
      <h2 class="text-slate-500 font-bold uppercase tracking-wider text-[10px]">— SYSTEM DIRECTORY</h2>
      <ul class="space-y-3">
        <li>
          <a href="/login" data-astro-reload class="text-white underline underline-offset-4 hover:text-slate-300 native-route">/login</a>
          <span class="text-slate-500 ml-2">— Secure SSO pipeline for authorized domains (Okta/Entra).</span>
        </li>
        <li>
          <a href="/integrity-portal" data-astro-reload class="text-white underline underline-offset-4 hover:text-slate-300 native-route">/integrity-portal</a>
          <span class="text-slate-500 ml-2">— Live continuous controls dashboard for Metric A/B.</span>
        </li>
        <li>
          <a href="/architecture" data-astro-reload class="text-white underline underline-offset-4 hover:text-slate-300 native-route">/architecture</a>
          <span class="text-slate-500 ml-2">— System blueprints, non-linear math specifications and stateless edge pipelines.</span>
        </li>
        <li>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-white underline underline-offset-4 hover:text-slate-300">/documentation</a>
          <span class="text-slate-500 ml-2">— Full code in public repository, and soon math proofs and API specifications.</span>
        </li>
        <li>
          <a href="/onboarding" data-astro-reload class="text-white underline underline-offset-4 hover:text-slate-300 native-route">/onboarding</a>
          <span class="text-slate-500 ml-2">— Request tenant network provisioning parameters. E-mail irradi.ato.rs, replace first dot with @.</span>
        </li>
      </ul>
    </section>

    <!-- Live Math Simulator -->
    <section class="mb-16 space-y-6 pt-8 border-t border-slate-900">
      <div class="space-y-1">
        <h2 class="text-slate-500 font-bold uppercase tracking-wider text-[10px]">— LIVE MATHEMATICAL SIMULATOR</h2>
        <p class="text-slate-400">
          Demonstrating the **Zero Property** (Risk Switch). Inject an exploit vector to test how Metric B collapses to zero while traditional additive metrics (Metric A) mask systemic failure.
        </p>
      </div>

      <!-- Action Commands -->
      <div class="flex gap-4">
        <button id="injectBtn" type="button" class="text-white underline underline-offset-4 hover:text-slate-300 font-bold text-left cursor-pointer">
          [RUN_SIMULATION: INJECT_CRITICAL_FAILURE]
        </button>
        <button id="resetBtn" type="button" class="text-slate-500 underline underline-offset-4 hover:text-slate-400 text-left cursor-pointer">
          [RESET_MATRIX]
        </button>
      </div>

      <!-- Raw Text Posture Outputs Board -->
      <div class="space-y-1.5 pt-2">
        <div>METRIC A (COMPLIANCE EFFORT) : <span id="resA" class="text-white font-bold">100%</span></div>
        <div>METRIC B (SYSTEMIC INTEGRITY) : <span id="resB" class="text-emerald-400 font-bold transition-colors">100%</span></div>
        <div>CORE OPERATIONAL STATUS     : <span id="resStatus" class="text-emerald-400 font-bold transition-colors font-mono">NOMINAL</span></div>
        <div id="breachLocationLine" class="hidden text-rose-500 font-bold font-mono">BREACH VECTOR ENFORCED    : <span id="resBreach">-</span></div>
      </div>

      <!-- Manual Matrix Controls -->
      <div class="space-y-3 pt-4 border-t border-slate-900">
        <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">Manual Matrix Controls</span>

        <div class="space-y-2 max-w-md">
          <div class="flex justify-between items-center">
            <span>Function (E1: Structures) :</span>
            <div class="flex items-center gap-2">
              <input type="range" min="0" max="1" step="0.05" value="1" data-idx="0" class="sim-slider w-24 h-px bg-slate-800 appearance-none accent-white cursor-pointer" />
              <span id="lbl-0" class="text-white min-w-[24px] text-right">1.0</span>
            </div>
          </div>

          <div class="flex justify-between items-center">
            <span>Elements (E2: Contents)    :</span>
            <div class="flex items-center gap-2">
              <input type="range" min="0" max="1" step="0.05" value="1" data-idx="1" class="sim-slider w-24 h-px bg-slate-800 appearance-none accent-white cursor-pointer" />
              <span id="lbl-1" class="text-white min-w-[24px] text-right">1.0</span>
            </div>
          </div>

          <div class="flex justify-between items-center">
            <span>Execution (E3: Facilities):</span>
            <div class="flex items-center gap-2">
              <input type="range" min="0" max="1" step="0.05" value="1" data-idx="2" class="sim-slider w-24 h-px bg-slate-800 appearance-none accent-white cursor-pointer" />
              <span id="lbl-2" class="text-white min-w-[24px] text-right">1.0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const apiEndpoint = `${window.location.origin}/api/v1/compute`;

      let simMatrix = [
        [0.95, 0.95, 0.95],
        [0.95, 0.95, 0.95],
        [0.95, 0.95, 0.95],
        [0.95, 0.95, 0.95]
      ];

      // Explicitly allow navigation paths to fire cleanly without scripting lockouts
      document.querySelectorAll('.native-route').forEach(link => {
        link.addEventListener('click', (e) => {
          e.stopPropagation();
        });
      });

      async function dispatchSimulationPipeline() {
        try {
          const response = await fetch(apiEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ matrix: simMatrix })
          });
          if (!response.ok) throw new Error(`HTTP_FAULT: ${response.status}`);
          const data = await response.json();
          renderUiUpdate(data);
        } catch (err) {
          console.error("Calculation transmission interrupted:", err);
        }
      }

      function renderUiUpdate(data: any) {
        const resA = document.getElementById('resA');
        const resB = document.getElementById('resB');
        const statusText = document.getElementById('resStatus');
        const breachLine = document.getElementById('breachLocationLine');

        // Extract parameters safely matching your core backend schema fields
        const compScore = data.metric_a_compliance ?? data.metricAMaturityIndex ?? 0;
        const integScore = data.metric_b_integrity ?? data.metricBLiveIntegrity ?? 0;

        if (resA) resA.innerText = (compScore * 100).toFixed(0) + '%';
        if (resB) resB.innerText = (integScore * 100).toFixed(0) + '%';

        if (statusText) {
          statusText.innerText = data.status || (integScore < 0.20 ? "CRITICAL_RISK_SWITCH_TRIGGERED" : "NOMINAL");
          if (integScore === 0 || statusText.innerText === "CRITICAL_RISK_SWITCH_TRIGGERED") {
            statusText.className = "text-rose-500 font-bold font-mono";
            if (resB) resB.className = "text-rose-500 font-bold";
          } else {
            statusText.className = "text-emerald-400 font-bold font-mono";
            if (resB) resB.className = "text-emerald-400 font-bold";
            if (breachLine && !document.getElementById('injectBtn')?.dataset.activeBreach) {
              breachLine.classList.add('hidden');
            }
          }
        }
      }
      // Dynamic Catastrophic Injector Trigger
      document.getElementById('injectBtn')?.addEventListener('click', (e) => {
        e.preventDefault();

        simMatrix = [
          [0.95, 0.95, 0.95],
          [0.95, 0.95, 0.95],
          [0.95, 0.95, 0.95],
          [0.95, 0.95, 0.95]
        ];

        const randomRow = Math.floor(Math.random() * 4);
        const randomCol = Math.floor(Math.random() * 3);
        simMatrix[randomRow][randomCol] = 0.0;

        const domainNames = ["FUNCTION", "FEATURES", "ELEMENTS", "EXECUTION"];
        const enablerNames = ["STRUCTURES", "CONTENTS", "FACILITIES"];

        const locationLine = document.getElementById('breachLocationLine');
        const locationText = document.getElementById('resBreach');
        const injectBtn = document.getElementById('injectBtn');

        if (locationLine && locationText && injectBtn) {
          locationText.innerText = `${domainNames[randomRow]} // ${enablerNames[randomCol]}`;
          locationLine.classList.remove('hidden');
          injectBtn.dataset.activeBreach = "true";
        }

        // Sync sliders visually to match structural drops
        const sliders = document.querySelectorAll('.sim-slider');
        sliders.forEach((slider) => {
          const s = slider as HTMLInputElement;
          const idx = parseInt(s.getAttribute('data-idx') || '0');
          if (idx === randomCol) {
            s.value = "0";
            const label = document.getElementById(`lbl-${idx}`);
            if (label) label.innerText = "0.0";
          }
        });

        dispatchSimulationPipeline();
      });

      // Reset Board Action
      document.getElementById('resetBtn')?.addEventListener('click', (e) => {
        e.preventDefault();

        const injectBtn = document.getElementById('injectBtn');
        if (injectBtn) delete injectBtn.dataset.activeBreach;

        const breachLine = document.getElementById('breachLocationLine');
        if (breachLine) breachLine.classList.add('hidden');

        simMatrix = [
          [0.95, 0.95, 0.95],
          [0.95, 0.95, 0.95],
          [0.95, 0.95, 0.95],
          [0.95, 0.95, 0.95]
        ];

        // Reset slide configurations back to standard baselines
        const sliders = document.querySelectorAll('.sim-slider');
        sliders.forEach((slider) => {
          const s = slider as HTMLInputElement;
          s.value = "1";
          const idx = s.getAttribute('data-idx');
          const label = document.getElementById(`lbl-${idx}`);
          if (label) label.innerText = "1.0";
        });

        dispatchSimulationPipeline();
      });

      // Update parameters from input slider controls
      document.querySelectorAll('.sim-slider').forEach(slider => {
        slider.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-idx') || '0');
          const val = parseFloat(target.value);

          const label = document.getElementById(`lbl-${idx}`);
          if (label) label.innerText = val.toFixed(1);

          // Clear active injector labels if manually modifying settings
          const injectBtn = document.getElementById('injectBtn');
          if (val > 0 && injectBtn) {
            delete injectBtn.dataset.activeBreach;
          }

          // Propagate column configurations evenly for baseline matrix calculation simulation
          for (let i = 0; i < 4; i++) {
            simMatrix[i][idx] = val;
          }
          dispatchSimulationPipeline();
        });
      });

      // Initial execution run to set default state metrics bounds on screen load
      dispatchSimulationPipeline();
    });
  </script>
</BaseLayout>
