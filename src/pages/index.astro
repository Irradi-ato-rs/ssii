---
// src/pages/index.astro
---
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Sovereign Systemic Integrity Intelligence (SSII)</title>
		<script src="https://cdn.tailwindcss.com"></script>
	</head>
	<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between p-6">
		<main class="max-w-5xl w-full mx-auto space-y-12 my-auto py-8">
			<!-- Header Branding -->
			<div class="text-center space-y-4">
				<span class="inline-flex bg-cyan-950/40 border border-cyan-800/40 text-cyan-400 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-widest shadow-sm shadow-cyan-950/50">
					🛡️ Dual-Math Sovereign Risk Engine
				</span>
				<h1 class="text-4xl md:text-5xl font-black text-white tracking-tight bg-clip-text text-transparent bg-gradient-to-b from-white to-slate-400">
					Sovereign Systemic Integrity Intelligence
				</h1>
				<p class="text-xs md:text-sm text-slate-400 max-w-xl mx-auto">
					Exposing security theater through a mathematical bifurcation of reported compliance maturity and localized operational risk vectors.
				</p>
			</div>

			<!-- Core Dashboards Group -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Metric A Output Dashboard Card -->
				<div class="bg-slate-900/60 border border-slate-800 p-6 rounded-2xl relative overflow-hidden backdrop-blur-sm">
					<div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-60"></div>
					<div class="flex justify-between items-start mb-4">
						<h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Metric A: Maturity Matrix</h2>
						<span class="text-[10px] text-emerald-400 bg-emerald-950/40 border border-emerald-800/40 px-2 py-0.5 rounded font-medium">Continuous</span>
					</div>
					<div class="flex items-baseline space-x-1 py-4">
						<span id="metric-a-display" class="text-5xl font-black text-white tracking-tight">4.00</span>
						<span class="text-sm font-semibold text-slate-500">/ 4.0</span>
					</div>
					<p class="text-[11px] text-slate-400 leading-relaxed">
						Linear double sum metric evaluating broad compliance trajectories. For board reporting, cyber insurance benchmarks, and framework roadmaps.
					</p>
				</div>

				<!-- Metric B Output Dashboard Card -->
				<div id="metric-b-card" class="bg-slate-900/60 border border-slate-800 p-6 rounded-2xl relative overflow-hidden backdrop-blur-sm transition-colors duration-300">
					<div id="metric-b-bar" class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 to-cyan-500 opacity-60 transition-all duration-300"></div>
					<div class="flex justify-between items-start mb-4">
						<h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Metric B: SI Live Operational</h2>
						<span id="status-tag" class="text-[10px] text-cyan-400 bg-cyan-950/40 border border-cyan-800/40 px-2 py-0.5 rounded font-medium transition-colors duration-300">Resilient</span>
					</div>
					<div class="flex items-baseline space-x-1 py-4">
						<span id="metric-b-display" class="text-5xl font-black text-white tracking-tight">1.00</span>
						<span class="text-sm font-semibold text-slate-500">/ 1.0</span>
					</div>
					<p class="text-[11px] text-slate-400 leading-relaxed">
						The risk switch. Multiplicative logic factoring downstream cascading decay modifiers. Drops to zero instantly if dependencies fail thresholds.
					</p>
				</div>

				<!-- Theater Gap Output Dashboard Card -->
				<div class="bg-slate-900/60 border border-slate-800 p-6 rounded-2xl relative overflow-hidden backdrop-blur-sm">
					<div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-violet-500 to-fuchsia-500 opacity-60"></div>
					<div class="flex justify-between items-start mb-4">
						<h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Theater Gap Deviation</h2>
						<span class="text-[10px] text-violet-400 bg-violet-950/40 border border-violet-800/40 px-2 py-0.5 rounded font-medium">Delta Delta</span>
					</div>
					<div class="flex items-baseline space-x-1 py-4">
						<span id="gap-display" class="text-5xl font-black text-white tracking-tight">0.00</span>
						<span class="text-sm font-semibold text-slate-500">Δ</span>
					</div>
					<p class="text-[11px] text-slate-400 leading-relaxed">
						Tracks divergence between normalized Metric A compliance and live operational exposure. Higher deltas signal dangerous "compliance camouflage."
					</p>
				</div>
			</div>

			<!-- Interactive Engineering Simulator Space -->
			<div class="w-full bg-slate-900 border border-slate-800 rounded-2xl relative overflow-hidden shadow-2xl">
				<div class="border-b border-slate-800 bg-slate-950/60 px-6 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
					<div>
						<h3 class="text-sm font-bold text-slate-200">Interactive Math In-Memory Simulator</h3>
						<p class="text-[11px] text-slate-500">Simulate incoming real-time telemetry from Sentinel, Tenable, and Okta platforms.</p>
					</div>
					<!-- Reset Configuration Controls -->
					<button id="reset-btn" class="text-[10px] border border-slate-700 bg-slate-900 hover:bg-slate-800 text-slate-300 font-bold px-3 py-1.5 rounded transition">
						Reset Configuration Vectors
					</button>
				</div>

				<!-- Control Panel Matrix -->
				<div class="p-6 space-y-6">
					<!-- Row 1: C1 Function -->
					<div class="space-y-3 bg-slate-950/40 border border-slate-800/60 p-4 rounded-xl">
						<div class="flex justify-between items-center">
							<span class="text-xs font-bold text-slate-300 flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-sky-500"></span>
								C₁ Function: Identity Core Architecture (Okta Engine)
							</span>
							<span id="v1-display" class="text-xs font-mono font-bold text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">V₁: 1.00</span>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₁ Structure (Weight 0.4)</label>
								<input type="range" min="0" max="1" step="0.05" value="1" data-row="0" data-col="0" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500 range-slider">
							</div>
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₂ Content (Weight 0.3)</label>
								<input type="range" min="0" max="1" step="0.05" value="1" data-row="0" data-col="1" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500 range-slider">
							</div>
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₃ Facilities (Weight 0.3)</label>
								<input type="range" min="0" max="1" step="0.05" value="1" data-row="0" data-col="2" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500 range-slider">
							</div>
						</div>
					</div>

					<!-- Row 2: C2 Features -->
					<div class="space-y-3 bg-slate-950/40 border border-slate-800/60 p-4 rounded-xl">
						<div class="flex justify-between items-center">
							<span class="text-xs font-bold text-slate-300 flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-purple-500"></span>
								C₂ Features: Guardrails & Threat Landscapes (Tenable Agents)
							</span>
							<span id="v2-display" class="text-xs font-mono font-bold text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">V₂: 1.00</span>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₁ Structure (Weight 0.4)</label>
								<input type="range" min="0" max="1" step="0.05" value="1" data-row="1" data-col="0" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-purple-500 range-slider">
							</div>
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₂ Content (Weight 0.3)</label>
								<input type="range" min="0" max="1" step="0.05" value="1" data-row="1" data-col="1" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-purple-500 range-slider">
							</div>
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₃ Facilities (Weight 0.3)</label>
								<input type="range" min="0" max="1" step="0.05" value="1" data-row="1" data-col="2" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-purple-500 range-slider">
							</div>
						</div>
					</div>

					<!-- Row 3: C3 Elements -->
					<div class="space-y-3 bg-slate-950/40 border border-slate-800/60 p-4 rounded-xl">
						<div class="flex justify-between items-center">
							<span class="text-xs font-bold text-slate-300 flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-amber-500"></span>
								C₃ Elements: Cryptography & Atomic Blocks (API Keys / Key Vaults)
							</span>
							<span id="v3-display" class="text-xs font-mono font-bold text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">V₃: 1.00</span>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₁ Structure (Weight 0.4)</label>
								<input type="range" min="0" max="1" step="0.05" value="1" data-row="2" data-col="0" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-500 range-slider">
							</div>
							<div class="space-y-1">
								<label class="text-[10px] text-slate-500 block">E₂ Content (Weight 0.3)</label>
E₃ Facilities (Weight 0.3)C₄ Execution: Runtime Signals & SIEM Automation (Sentinel Playbooks)V₄: 1.00E₁ Structure (Weight 0.4)E₂ Content (Weight 0.3)E₃ Facilities (Weight 0.3)Enterprise Token Entry© 2026 Sovereign Systemic Integrity Intelligence. In-flight processing secured under Cloudflare Worker Isolation.// Initialize internal mathematical statesconst weights = [0.4, 0.3, 0.3];const tau = 0.80; // Operational Collapse Thresholdconst matrix = [[1.0, 1.0, 1.0], // C1 Row[1.0, 1.0, 1.0], // C2 Row[1.0, 1.0, 1.0], // C3 Row[1.0, 1.0, 1.0]  // C4 Row];// Grab UI Elementsconst sliders = document.querySelectorAll('.range-slider');const metricADisplay = document.getElementById('metric-a-display');const metricBDisplay = document.getElementById('metric-b-display');const gapDisplay = document.getElementById('gap-display');const metricBCard = document.getElementById('metric-b-card');const metricBBar = document.getElementById('metric-b-bar');const statusTag = document.getElementById('status-tag');const resetBtn = document.getElementById('reset-btn');function calculateMathEngine() {let metricA = 0;const v =;// Step 1: Calculate raw row weights and linear maturity matrixfor (let i = 0; i < 4; i++) {let rowScore = 0;for (let j = 0; j < 3; j++) {const value = matrix[i][j];rowScore += value * weights[j];}v[i] = rowScore;metricA += rowScore;// Update individual dynamic row display metricsconst displayElement = document.getElementById(v${i+1}-display);if (displayElement) displayElement.textContent = V${i+1}: ${rowScore.toFixed(2)};}// Step 2: Apply Chained Downstream Cascading Penalties (Chained Dependent Multiplications)const v_fu = v[0];const gamma_1 = v_fu >= tau ? 1.0 : Math.pow(v_fu / tau, 2);const v_fe = v[1] * gamma_1;const gamma_2 = v_fe >= tau ? 1.0 : Math.pow(v_fe / tau, 2);const v_el = v[2] * gamma_2;const gamma_3 = v_el >= tau ? 1.0 : Math.pow(v_el / tau, 2);const v_ex = v[3] * gamma_3;// Final Product Calculationconst metricB = v_fu * v_fe * v_el * v_ex;// Step 3: Extract Theater Deviationconst normalizedA = metricA / 4.0;const theaterGap = normalizedA - metricB;// Step 4: Inject Computations back into the DOMif (metricADisplay) metricADisplay.textContent = metricA.toFixed(2);if (metricBDisplay) metricBDisplay.textContent = metricB.toFixed(2);if (gapDisplay) gapDisplay.textContent = theaterGap.toFixed(2);// Step 5: Mutate UI State styling on Operational Failureif (metricB === 0) {metricBCard?.classList.remove('bg-slate-900/60', 'border-slate-800');metricBCard?.classList.add('bg-rose-950/20', 'border-rose-900/40');metricBBar?.classList.remove('from-blue-500', 'to-cyan-500');metricBBar?.classList.add('from-rose-600', 'to-red-600');if (statusTag) {statusTag.textContent = "Collapse Detected";statusTag.classList.remove('text-cyan-400', 'bg-cyan-950/40', 'border-cyan-800/40');statusTag.classList.add('text-rose-400', 'bg-rose-950/40', 'border-rose-800/40');}} else {metricBCard?.classList.add('bg-slate-900/60', 'border-slate-800');metricBCard?.classList.remove('bg-rose-950/20', 'border-rose-900/40');metricBBar?.classList.add('from-blue-500', 'to-cyan-500');metricBBar?.classList.remove('from-rose-600', 'to-red-600');if (statusTag) {statusTag.textContent = "Resilient";statusTag.classList.add('text-cyan-400', 'bg-cyan-950/40', 'border-cyan-800/40');statusTag.classList.remove('text-rose-400', 'bg-rose-950/40', 'border-rose-800/40');}}}// Capture runtime event inputs from standard user sliderssliders.forEach(slider => {slider.addEventListener('input', (e) => {const target = e.target as HTMLInputElement;const row = parseInt(target.getAttribute('data-row') || '0');const col = parseInt(target.getAttribute('data-col') || '0');matrix[row][col] = parseFloat(target.value);calculateMathEngine();});});// Reset Matrix States Configuration FunctionalityresetBtn?.addEventListener('click', () => {sliders.forEach(slider => {const s = slider as HTMLInputElement;s.value = "1";const row = parseInt(s.getAttribute('data-row') || '0');const col = parseInt(s.getAttribute('data-col') || '0');matrix[row][col] = 1.0;});calculateMathEngine();});// Perform initial page compilation execution passcalculateMathEngine();
