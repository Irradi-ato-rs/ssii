---
// src/pages/documentation.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="VoidMetric | Documentation">
  <main class="w-full max-w-2xl mx-auto px-4 py-16 text-left text-slate-300 font-mono text-xs leading-relaxed selection:bg-slate-800">

    <header class="mb-12 space-y-2">
      <h1 class="text-xl font-bold tracking-tight text-white"><a href="https://ssii.fzoirm.com">VOIDMETRIC</a> DOCUMENTATION</h1>
      <p class="text-slate-400">Sovereign Systemic Integrity Intelligence</p>
      <p class="text-slate-500">Zero-Payload-Persistence. Edge-Native. Deterministic and Non-Linear Operational Validation Engine.</p>
    </header>

    <section class="mb-12 space-y-3">
      <h2 class="text-slate-500 font-bold uppercase tracking-wider text-[10px]">— PROJECT PUBLIC REPOSITORIES</h2>
      <p class="text-slate-400">
        To guarantee mathematical neutrality while preserving security and privacy, VoidMetric splits operations into strictly isolated repository boundaries underpinning enterprise and open-source platforms.
      </p>
      <div class="space-y-4 pt-2">
        <div>
          <span class="text-white font-bold"><a href="https://ssii.fzoirm.com">ssii.fzoirm.com</a></span>
          <p class="text-slate-500 mt-1 pl-4">
            VoidMetric homepage and workers including ssii, ssii-consumer and dispatcher via <a href="https://github.com/Irradiators/ssii">github.com/Irradiators/ssii</a>, not the current repository, but it will be anytime now.
          </p>
        </div>
        <div>
          <span class="text-white font-bold"><a href="https://void.fzoirm.com">void.fzoirm.com</a></span>
          <p class="text-slate-500 mt-1 pl-4">
            VoidMetric webhook URL generator for enterprise tenants and ingestion workers including void and large-ingest-consumer. (It will become public soon and when it did, it will be here <a href="https://github.com/Irradiators/void">github.com/Irradiators/void</a>.)
          </p>
        </div>
        <div>
          <span class="text-white font-bold"><a href="https://github.com/Irradiators/integrity-adapters">github.com/Irradiators/integrity-adapters</a></span>
          <p class="text-slate-500 mt-1 pl-4">
            VoidMetric integrity adapters for open-source platforms.
          </p>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>   