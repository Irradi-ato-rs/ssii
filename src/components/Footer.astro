---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const donations = {
  btc: "bc1q8z8ype30l5ztkmrsnj9lmap4kdd370wkstsvrj",
  eth: "0x930Fa53551E641d47Cf0EcafDD230B2eBEa61DA2",
  xlm: "GAZKN3ZL2DQ5DJT6QO6OHAT2QAQ5JMFQCK2IFXHISPR5KJVT7BPAJC4O"
};
---

<!-- Added bg-white, changed text to text-slate-900 for contrast -->
<footer class="border-t border-slate-200 bg-white pt-8 text-[10px] text-slate-900 mt-12 w-full text-left font-mono">
  
  <!-- Crypto Funding and Donations -->
  <div class="space-y-1 mt-8 mb-12">
    <!-- Updated header to darker color -->
    <p class="font-bold text-slate-800">Fund VoidMetric:</p>
    
    <!-- Updated labels to darker gray -->
    <p><span class="text-slate-600">BTC:</span> <code class="bg-slate-200 px-1 rounded text-slate-900">{donations.btc}</code></p>
    <p><span class="text-slate-600">ETH:</span> <code class="bg-slate-200 px-1 rounded text-slate-900">{donations.eth}</code></p>
    <p><span class="text-slate-600">XLM:</span> <code class="bg-slate-200 px-1 rounded text-slate-900">{donations.xlm}</code></p>
  </div>

  <!-- Copyright -->
  <div class="space-y-1">
    <p>&#169; {currentYear} VoidMetric. Secure. No data stored. Ever.</p>
    <p>Sovereign Systemic Integrity Intelligence ⟢</p>
  </div>
</footer>   
