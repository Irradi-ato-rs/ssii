---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const donations = {
  btc: "bc1q8z8ype30l5ztkmrsnj9lmap4kdd370wkstsvrj",
  eth: "0x930Fa53551E641d47Cf0EcafDD230B2eBEa61DA2",
  xlm: "GAZKN3ZL2DQ5DJT6QO6OHAT2QAQ5JMFQCK2IFXHISPR5KJVT7BPAJC4O"
};
---

<!-- Text changed to white (text-white), labels to light gray (text-slate-400) -->
<footer class="border-t border-slate-800 pt-8 text-[10px] text-white mt-12 w-full text-left font-mono bg-transparent">
  
  <!-- Crypto Funding and Donations -->
  <div class="space-y-1 mt-8 mb-12">
    <p class="font-bold text-slate-300">Fund VoidMetric:</p>
    <!-- Labels slightly dimmer, addresses bright white -->
    <p><span class="text-slate-400">BTC:</span> <code class="bg-slate-900/80 px-1 rounded text-white">{donations.btc}</code></p>
    <p><span class="text-slate-400">ETH:</span> <code class="bg-slate-900/80 px-1 rounded text-white">{donations.eth}</code></p>
    <p><span class="text-slate-400">XLM:</span> <code class="bg-slate-900/80 px-1 rounded text-white">{donations.xlm}</code></p>
  </div>

  <!-- Copyright -->
  <div class="space-y-1">
    <p>&#169; {currentYear} VoidMetric. Secure. No data stored. Ever.</p>
    <p>Sovereign Systemic Integrity Intelligence ⟢</p>
  </div>
</footer>   
