---
// src/components/Footer.astro
// Automates the year at compile-time on the server side
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-900 pt-8 text-[10px] text-slate-600 space-y-1 mt-12 w-full text-left font-mono">
  <p>&copy; {currentYear} VoidMetric. Secure. No data stored. Ever.</p>
  <p>Sovereign Systemic Integrity Intelligence ⟢</p>
</footer>
