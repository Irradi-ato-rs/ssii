{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ssii",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": [
    "nodejs_compat",
    "disable_nodejs_process_v2"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { 
    "enabled": true 
  },
  "kv_namespaces": [
    {
      "binding": "VM_TENANT_DIRECTORY",
      "id": "01d2aa05ebdf4a32b966bcd37d712bfe"
    },
    {
      "binding": "VM_PROPRIETARY_PARSERS",
      "id": "fa7275bedb434ee8b9f9b82555930827"
    },
    {
      "binding": "SESSION", 
      "id": "fbdbf19fdf494f388a8c8669c002ce10"
    }
    {
      "binding": "VM_LIVE_POSTURE_CACHE",
      "id": "b1bce78115ec487a914c6e7d3420dd6b"
    }
  ]
}   