{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ssii",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat",
    "disable_nodejs_process_v2"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "PRIVATE_ROLE_ALLOWLIST": "governance,admin,executive,engineer,operator",
    "IDP_ISSUER": "https://login.microsoftonline.com/442355f4-8c8f-4101-ae2a-3db0ca8d44ac/v2.0",
    "IDP_AUTH_ENDPOINT": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
    "IDP_TOKEN_ENDPOINT": "https://login.microsoftonline.com/442355f4-8c8f-4101-ae2a-3db0ca8d44ac/oauth2/v2.0/token",
    "IDP_JWKS_URI": "https://login.microsoftonline.com/442355f4-8c8f-4101-ae2a-3db0ca8d44ac/discovery/v2.0/keys",
    "IDP_END_SESSION_ENDPOINT": "https://login.microsoftonline.com/442355f4-8c8f-4101-ae2a-3db0ca8d44ac/oauth2/v2.0/logout"
  },   
  "kv_namespaces": [
    {
      "binding": "VM_TENANT_DIRECTORY",
      "id": "01d2aa05ebdf4a32b966bcd37d712bfe"
    },
    {
      "binding": "VM_LIVE_POSTURE_CACHE",
      "id": "b1bce78115ec487a914c6e7d3420dd6b"
    },
    {
      "binding": "SESSION",
      "id": "2ce43a786c5c4f858bbb1bf2265ce31d"
    }
  ],
  "services": [
    {
      "binding": "PRIVATE_GATEWAY",
      "service": "void"
    }
  ]
}   