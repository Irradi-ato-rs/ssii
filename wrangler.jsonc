{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ssii",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { 
    "enabled": true 
  },
  "kv_namespaces": [
    {
      "binding": "VM_TENANT_DIRECTORY",
      "id": "01d2aa05ebdf4a32b966bcd37d712bfe"
    },
    {
      "binding": "VM_LIVE_POSTURE_CACHE",
      "id": "b1bce78115ec487a914c6e7d3420dd6b"
    },
    {
      "binding": "SESSION",
      "id": "2ce43a786c5c4f858bbb1bf2265ce31d"
    }
  ],
  "services": [
    {
      "binding": "PRIVATE_GATEWAY",
      "service": "void"
    }
  ]
}